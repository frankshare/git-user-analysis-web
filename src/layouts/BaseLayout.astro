---
import '../styles/global.css';
const BASE = import.meta.env.BASE_URL;

interface Props {
  title?: string;
  description?: string;
  active?: 'people' | 'works' | 'research' | 'about';
  /** 页脚用小字说明 */
  note?: string;
}

const {
  title = '星册 · 高星创作者档案馆',
  description = '收录高星 GitHub 创作者与他们的作品：谁在做什么、代表作是哪个、往哪看。',
  active = 'people',
  note,
} = Astro.props;

const nav = [
  { key: 'people', label: '人物', href: `${BASE}` },
  { key: 'works', label: '作品', href: `${BASE}works/` },
  { key: 'research', label: '研究', href: `${BASE}research/` },
  { key: 'about', label: '关于', href: `${BASE}about/` },
] as const;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- 顶部书脊 -->
    <header class="relative z-20 sticky top-0 border-b border-slate-800 bg-[#f6efdf]/88 backdrop-blur-md">
      <div class="wrap flex h-14 items-center justify-between gap-4">
        <a href={`${BASE}`} class="group flex items-center gap-2.5">
          <span
            class="grid h-7 w-7 place-items-center rounded-[2px] bg-[#b23a2b] font-display text-[13px] font-semibold leading-none text-[#fbf5e7] transition-transform duration-500 group-hover:-rotate-6"
            >星</span
          >
          <span class="flex items-baseline gap-2">
            <span class="font-display text-[17px] font-semibold tracking-tight">星册</span>
            <span class="labelmono hidden sm:inline">high-star archive</span>
          </span>
        </a>

        <nav class="flex items-center gap-0.5 sm:gap-1 overflow-x-auto whitespace-nowrap [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {
            nav.map((n) => (
              <a
                href={n.href}
                aria-current={active === n.key ? 'page' : undefined}
                class:list={[
                  'relative px-2.5 py-1.5 text-sm transition-colors sm:px-3',
                  active === n.key
                    ? 'text-white'
                    : 'text-slate-400 hover:text-slate-200',
                ]}
              >
                {n.label}
                {active === n.key && (
                  <span class="absolute inset-x-2.5 -bottom-[13px] h-[2px] bg-[#b23a2b] sm:inset-x-3" />
                )}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="relative z-10 flex-1">
      <slot />
    </main>

    <footer class="relative z-10 mt-16 border-t border-slate-800">
      <div class="wrap flex flex-col gap-4 py-8 text-xs text-slate-500 sm:flex-row sm:items-end sm:justify-between">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2">
            <span class="seal">星册</span>
            <span class="labelmono">since 2026·10</span>
          </div>
          <p class="max-w-md leading-relaxed">
            {note ?? '数据来自 GitHub 公开 API 快照；星数为 type=source 仓库合计，排除 fork。每个数字都带日期，口径写在「关于」里。'}
          </p>
        </div>
        <div class="flex items-center gap-4 font-mono text-[11px]">
          <a href="https://github.com/frankshare/git-user-analysis-web" class="ulink" target="_blank" rel="noopener">source</a>
          <a href={`${BASE}about/`} class="ulink">口径</a>
          <a href={`${BASE}research/`} class="ulink">研究</a>
        </div>
      </div>
    </footer>

    <script>
      // 滚动入场
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
      );
      document.querySelectorAll('.reveal').forEach((el, i) => {
        (el as HTMLElement).style.animationDelay = `${Math.min(i * 45, 420)}ms`;
        io.observe(el);
      });
    </script>
  </body>
</html>
