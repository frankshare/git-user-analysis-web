---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllUsers } from '../lib/data';
const BASE = import.meta.env.BASE_URL;

const users = getAllUsers();
const num = (v: unknown) => (typeof v === 'number' ? v : parseInt(String(v ?? 0), 10) || 0);
const CJK = '\u4e00-\u9fa5';
const hasCjk = (s: string) => new RegExp('[' + CJK + ']').test(s || '');

type Work = {
  name: string;
  url: string;
  stars: number;
  lang: string;
  layer: string;
  cat: string;
  desc: string;
  updated: string;
  author: string;
  authorName: string;
  zh: boolean;
};

const works: Work[] = users
  .flatMap((u) => {
    const sample = (u.repos || []).filter((r) => !r.fork).slice(0, 20);
    const zhRatio = sample.length
      ? sample.filter((r) => hasCjk(r.description || '')).length / sample.length
      : 0;
    return (u.repos || [])
      .filter((r) => !r.fork)
      .map((r) => ({
        name: r.name,
        url: r.url,
        stars: num(r.stars),
        lang: r.language || '—',
        layer: (r as any).layer || 'other',
        cat: (r as any).category || '',
        desc: r.description || '',
        updated: (r.updated_at || '').slice(0, 10),
        author: u.profile.login,
        authorName: u.profile.name || u.profile.login,
        zh: hasCjk(u.profile.name || '') || zhRatio >= 0.25,
      }));
  })
  .sort((a, b) => b.stars - a.stars);

const totalStars = works.reduce((a, w) => a + w.stars, 0);

// —— 分类：layer 为主，category 为辅 ——
// 把细的 layer 归到大类，避免十几个碎标签
const LAYER_GROUP: Record<string, string> = {
  skill: 'Skill 与知识库',
  persona: 'Skill 与知识库',
  catalog: 'Skill 与知识库',
  book: 'Skill 与知识库',
  tool: '工具与库',
  framework: '工具与库',
  app: '应用与客户端',
  profile: '应用与客户端',
  ecosystem: '生态与集成',
  research: '研究与写作',
  writing: '研究与写作',
  other: '其他',
};

const GROUP_ORDER = [
  'Skill 与知识库',
  '工具与库',
  '应用与客户端',
  '生态与集成',
  '研究与写作',
  '其他',
];

const groups = GROUP_ORDER.map((g) => {
  const items = works.filter((w) => (LAYER_GROUP[w.layer] ?? '其他') === g);
  const cats = new Map<string, number>();
  for (const w of items) {
    const c = w.cat || '未分类';
    cats.set(c, (cats.get(c) || 0) + 1);
  }
  return {
    name: g,
    items,
    stars: items.reduce((a, w) => a + w.stars, 0),
    top: [...cats.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6),
  };
}).filter((g) => g.items.length > 0);

const fmt = (n: number) => n.toLocaleString('en-US');
const kfmt = (n: number) =>
  n >= 10000 ? `${(n / 10000).toFixed(1).replace('.0', '')}w` : fmt(n);
const LIMIT = 40;
---

<BaseLayout title="卷二 · 作品 · 星册" active="works">
  <section class="wrap pt-10 sm:pt-14">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b border-slate-800 pb-7">
      <div>
        <div class="mb-4 flex items-center gap-3">
          <span class="seal">卷二 · 作品</span>
          <span class="labelmono">{fmt(works.length)} 件</span>
        </div>
        <h1 class="display text-[2.4rem] sm:text-[3.4rem]">
          <span class="line-up"><span>他们造出来的东西</span></span>
        </h1>
        <p class="mt-4 max-w-xl text-[14.5px] leading-[1.85] text-slate-400">
          同一批创作者的作品，按类别折叠。每类先看星数最高的几件，其余收在「更多」里。
        </p>
      </div>
      <dl class="grid grid-cols-3 gap-x-8 gap-y-3">
        <div>
          <dt class="labelmono">作品</dt>
          <dd class="font-mono text-[22px] leading-tight">{fmt(works.length)}</dd>
        </div>
        <div>
          <dt class="labelmono">类别</dt>
          <dd class="font-mono text-[22px] leading-tight">{groups.length}</dd>
        </div>
        <div>
          <dt class="labelmono">总星</dt>
          <dd class="font-mono text-[22px] leading-tight">{kfmt(totalStars)}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 分类折叠 -->
  <section class="wrap mt-6 space-y-3">
    {
      groups.map((g, gi) => (
        <details class="group/rv overflow-hidden rounded-[2px] border border-slate-800 bg-[#fbf5e7]/60" open={gi === 0}>
          <summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-3 transition-colors hover:bg-[#f6efdf]">
            <span class="font-mono text-[11px] text-slate-600">{String(gi + 1).padStart(2, '0')}</span>
            <h2 class="font-display text-[17px] font-semibold">{g.name}</h2>
            <span class="font-mono text-[11px] text-slate-500">{g.items.length} 件</span>
            <span class="font-mono text-[11px] text-slate-500">★{kfmt(g.stars)}</span>
            <span class="ml-auto hidden flex-wrap items-center gap-1.5 sm:flex">
              {g.top.map(([c, n]) => (
                <span class="rounded-[2px] border border-slate-800 px-1.5 py-px text-[10.5px] text-slate-500">
                  {c} <span class="font-mono text-slate-600">{n}</span>
                </span>
              ))}
            </span>
            <span class="shrink-0 font-mono text-xs text-slate-500 transition-transform duration-300 group-open/rv:rotate-90">
              →
            </span>
          </summary>

          <div class="border-t border-slate-800">
            <ol class="divide-y divide-slate-800/60">
              {g.items.slice(0, LIMIT).map((w, i) => (
                <li class="flex items-start gap-3 px-4 py-2.5 transition-colors hover:bg-[#f6efdf]">
                  <span class="mt-0.5 w-7 shrink-0 font-mono text-[11px] text-slate-600">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-baseline gap-x-2">
                      <a
                        href={w.url}
                        target="_blank"
                        rel="noopener"
                        class="ulink font-mono text-[13px] font-medium text-slate-100"
                      >
                        {w.name}
                      </a>
                      {w.cat && (
                        <span class="rounded-[2px] border border-slate-800 px-1 font-mono text-[10px] text-slate-500">
                          {w.cat}
                        </span>
                      )}
                      {w.lang !== '—' && (
                        <span class="font-mono text-[10.5px] text-slate-600">{w.lang}</span>
                      )}
                    </div>
                    {w.desc && (
                      <p class="mt-0.5 line-clamp-1 text-[12px] leading-relaxed text-slate-500">
                        {w.desc}
                      </p>
                    )}
                    <div class="mt-1 flex items-center gap-2 font-mono text-[10.5px] text-slate-600 sm:hidden">
                      <a href={`${BASE}u/${w.author}/`} class="text-slate-400">@{w.author}</a>
                      <span>★{kfmt(w.stars)}</span>
                    </div>
                  </div>
                  <a
                    href={`${BASE}u/${w.author}/`}
                    class="hidden w-[120px] shrink-0 truncate font-mono text-[11.5px] text-slate-400 transition-colors hover:text-[#b23a2b] sm:block"
                  >
                    @{w.author}
                  </a>
                  <span class="hidden w-[70px] shrink-0 text-right font-mono text-[12px] text-slate-300 sm:block">
                    {kfmt(w.stars)}
                  </span>
                  <span class="hidden w-[60px] shrink-0 text-right font-mono text-[10.5px] text-slate-600 sm:block">
                    {w.updated.slice(2)}
                  </span>
                </li>
              ))}
            </ol>

            {g.items.length > LIMIT && (
              <details class="group/more border-t border-slate-800">
                <summary class="cursor-pointer list-none px-4 py-2.5 text-center font-mono text-[11.5px] text-slate-500 transition-colors hover:bg-[#f6efdf] hover:text-[#b23a2b]">
                  更多 {g.items.length - LIMIT} 件 ▾
                </summary>
                <ol class="divide-y divide-slate-800/60 border-t border-slate-800">
                  {g.items.slice(LIMIT).map((w, i) => (
                    <li class="flex items-start gap-3 px-4 py-2.5 transition-colors hover:bg-[#f6efdf]">
                      <span class="mt-0.5 w-7 shrink-0 font-mono text-[11px] text-slate-600">
                        {String(LIMIT + i + 1).padStart(2, '0')}
                      </span>
                      <div class="min-w-0 flex-1">
                        <a
                          href={w.url}
                          target="_blank"
                          rel="noopener"
                          class="ulink font-mono text-[13px] font-medium text-slate-100"
                        >
                          {w.name}
                        </a>
                        {w.desc && (
                          <p class="mt-0.5 line-clamp-1 text-[12px] leading-relaxed text-slate-500">
                            {w.desc}
                          </p>
                        )}
                      </div>
                      <a
                        href={`${BASE}u/${w.author}/`}
                        class="hidden w-[120px] shrink-0 truncate font-mono text-[11.5px] text-slate-400 transition-colors hover:text-[#b23a2b] sm:block"
                      >
                        @{w.author}
                      </a>
                      <span class="hidden w-[70px] shrink-0 text-right font-mono text-[12px] text-slate-300 sm:block">
                        {kfmt(w.stars)}
                      </span>
                    </li>
                  ))}
                </ol>
              </details>
            )}
          </div>
        </details>
      ))
    }
  </section>

  <section class="wrap mt-10 border-t border-slate-800 pt-6">
    <p class="max-w-2xl text-[12.5px] leading-[1.9] text-slate-500">
      分类依据仓库的 <code class="font-mono text-slate-400">layer</code> 字段（工具 / 应用 / Skill / 人格 / 生态…），
      同类下再按中文语义类（<span class="text-slate-400">category</span>）细分。
      只收录 <code class="font-mono text-slate-400">type=source</code> 仓库，排除 fork。
    </p>
  </section>
</BaseLayout>
