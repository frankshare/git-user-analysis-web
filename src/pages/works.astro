---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllUsers } from '../lib/data';
import fs from 'node:fs';
import path from 'node:path';
const BASE = import.meta.env.BASE_URL;

const users = getAllUsers();

// 人工写的作品说明（覆盖 star 前 100）
const notesFile = path.resolve('src/data/work-notes.json');
const notes: Record<string, Record<string, string>> = fs.existsSync(notesFile)
  ? JSON.parse(fs.readFileSync(notesFile, 'utf-8'))
  : {};
const noteOf = (author: string, repo: string) => notes[author]?.[repo] || '';

// 「适合谁用 / 什么场景」：人工写的选型提示
const audFile = path.resolve('src/data/work-audience.json');
const audience: Record<string, Record<string, string>> = fs.existsSync(audFile)
  ? JSON.parse(fs.readFileSync(audFile, 'utf-8'))
  : {};
const audOf = (author: string, repo: string) => audience[author]?.[repo] || '';
const num = (v: unknown) => (typeof v === 'number' ? v : parseInt(String(v ?? 0), 10) || 0);
const CJK = '\u4e00-\u9fa5';
const hasCjk = (s: string) => new RegExp('[' + CJK + ']').test(s || '');

type Work = {
  name: string;
  url: string;
  stars: number;
  lang: string;
  layer: string;
  cat: string;
  desc: string;
  updated: string;
  author: string;
  authorName: string;
  zh: boolean;
};

const works: Work[] = users
  .flatMap((u) => {
    const sample = (u.repos || []).filter((r) => !r.fork).slice(0, 20);
    const zhRatio = sample.length
      ? sample.filter((r) => hasCjk(r.description || '')).length / sample.length
      : 0;
    return (u.repos || [])
      .filter((r) => !r.fork)
      .map((r) => ({
        name: r.name,
        url: r.url,
        stars: num(r.stars),
        lang: r.language || '—',
        layer: (r as any).layer || 'other',
        cat: (r as any).category || '',
        desc: r.description || '',
        updated: (r.updated_at || '').slice(0, 10),
        author: u.profile.login,
        authorName: u.profile.name || u.profile.login,
        zh: hasCjk(u.profile.name || '') || zhRatio >= 0.25,
      }));
  })
  .sort((a, b) => b.stars - a.stars);

const totalStars = works.reduce((a, w) => a + w.stars, 0);

// —— 分类：layer 为主，category 为辅 ——
// 把细的 layer 归到大类，避免十几个碎标签
const LAYER_GROUP: Record<string, string> = {
  skill: 'Skill 与知识库',
  persona: 'Skill 与知识库',
  catalog: 'Skill 与知识库',
  book: 'Skill 与知识库',
  tool: '工具与库',
  framework: '工具与库',
  app: '应用与客户端',
  profile: '应用与客户端',
  ecosystem: '生态与集成',
  research: '研究与写作',
  writing: '研究与写作',
  other: '其他',
};

const GROUP_ORDER = [
  'Skill 与知识库',
  '工具与库',
  '应用与客户端',
  '生态与集成',
  '研究与写作',
  '其他',
];

// —— 二级细分 ——
// 「其他」这组有 1,349 个不同的仓库名，没有可用的 category，只能按用途与语言再分。
const CONTENT_HINT = [
  'blog', 'site', 'docs', 'doc', 'note', 'talk', 'wiki', 'book', 'readme', 'resume', 'cv',
  'homepage', 'website', 'post', 'article', 'slide', 'deck', 'paper', 'writing',
  'dotfile', 'config', 'setup', 'homebrew', 'tap', 'shell', 'awesome', 'list',
];
const isContent = (w: Work) => {
  const hay = (w.name + ' ' + w.desc).toLowerCase();
  return CONTENT_HINT.some((k) => hay.includes(k));
};

// 二级标签：先看用途，再看语言
function subGroup(w: Work): string {
  if ((LAYER_GROUP[w.layer] ?? '其他') !== '其他') return '';
  if (isContent(w)) return '站点与内容';
  if (/^(dotfiles?$|homebrew|\.github|setup|config)/i.test(w.name)) return '配置与环境';
  return w.lang && w.lang !== '—' ? `${w.lang} 小工具` : '零散小工具';
}

const groups = GROUP_ORDER.map((g) => {
  const items = works
    .filter((w) => (LAYER_GROUP[w.layer] ?? '其他') === g)
    // 有人工说明的排前面（组内仍按星数），这样展开就能直接看到「解决什么」
    .sort((a, b) => {
      const na = noteOf(a.author, a.name) ? 1 : 0;
      const nb = noteOf(b.author, b.name) ? 1 : 0;
      return nb - na || b.stars - a.stars;
    });
  const cats = new Map<string, number>();
  for (const w of items) {
    const c = w.cat || '未分类';
    cats.set(c, (cats.get(c) || 0) + 1);
  }

  // 二级分组
  const subs = new Map<string, Work[]>();
  for (const w of items) {
    const k = subGroup(w);
    if (!k) continue;
    if (!subs.has(k)) subs.set(k, []);
    subs.get(k)!.push(w);
  }
  const subList = [...subs.entries()]
    .map(([name, ws]) => ({
      name,
      items: ws,
      stars: ws.reduce((a, w) => a + w.stars, 0),
    }))
    .sort((a, b) => b.items.length - a.items.length);

  return {
    name: g,
    items,
    stars: items.reduce((a, w) => a + w.stars, 0),
    top: [...cats.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6),
    subs: subList,
  };
}).filter((g) => g.items.length > 0);

const fmt = (n: number) => n.toLocaleString('en-US');
const kfmt = (n: number) =>
  n >= 10000 ? `${(n / 10000).toFixed(1).replace('.0', '')}w` : fmt(n);
const LIMIT = 40;
---

<BaseLayout title="卷二 · 作品 · 星册" active="works">
  <section class="wrap pt-10 sm:pt-14">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b border-slate-800 pb-7">
      <div>
        <div class="mb-4 flex items-center gap-3">
          <span class="seal">卷二 · 作品</span>
          <span class="labelmono">{fmt(works.length)} 件</span>
        </div>
        <h1 class="display text-[2.4rem] sm:text-[3.4rem]">
          <span class="line-up"><span>他们造出来的东西</span></span>
        </h1>
        <p class="mt-4 max-w-xl text-[14.5px] leading-[1.9] text-slate-400">
          同一批创作者的作品，按类别折叠。每类先看星数最高的几件，其余收在「更多」里。
        </p>
      </div>
      <dl class="grid grid-cols-3 gap-x-8 gap-y-3">
        <div>
          <dt class="labelmono">作品</dt>
          <dd class="font-mono text-[22px] leading-tight">{fmt(works.length)}</dd>
        </div>
        <div>
          <dt class="labelmono">类别</dt>
          <dd class="font-mono text-[22px] leading-tight">{groups.length}</dd>
        </div>
        <div>
          <dt class="labelmono">总星</dt>
          <dd class="font-mono text-[22px] leading-tight">{kfmt(totalStars)}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 分类折叠 -->
  <section class="wrap mt-6 space-y-3">
    {
      groups.map((g, gi) => (
        <details class="group/rv overflow-hidden rounded-[2px] border border-slate-800 bg-[#fbf5e7]/60" open={gi === 0}>
          <summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-3 transition-colors hover:bg-[#f6efdf]">
            <span class="font-mono text-[14px] text-slate-600">{String(gi + 1).padStart(2, '0')}</span>
            <h2 class="font-display text-[17px] font-semibold">{g.name}</h2>
            <span class="font-mono text-[14px] text-slate-500">{g.items.length} 件</span>
            <span class="font-mono text-[14px] text-slate-500">★{kfmt(g.stars)}</span>
            <span class="ml-auto hidden flex-wrap items-center gap-1.5 sm:flex">
              {g.top.map(([c, n]) => (
                <span class="rounded-[2px] border border-slate-800 px-1.5 py-px text-[14.5px] text-slate-500">
                  {c} <span class="font-mono text-slate-600">{n}</span>
                </span>
              ))}
            </span>
            <span class="shrink-0 font-mono text-xs text-slate-500 transition-transform duration-300 group-open/rv:rotate-90">
              →
            </span>
          </summary>

          <div class="border-t border-slate-800">
            {/* 二级细分标签 */}
            {g.subs.length > 0 && (
              <div class="flex flex-wrap items-center gap-1.5 border-b border-slate-800 px-5 py-3">
                <span class="labelmono mr-1">细分</span>
                {g.subs.map((s) => (
                  <span class="rounded-[2px] border border-slate-800 px-2 py-0.5 font-mono text-[13px] text-slate-500">
                    {s.name} <span class="text-slate-600">{s.items.length}</span>
                  </span>
                ))}
              </div>
            )}

            <ol class="divide-y divide-slate-800/60">
              {g.items.slice(0, LIMIT).map((w, i) => (
                <li class="flex items-start gap-3 px-4 py-2.5 transition-colors hover:bg-[#f6efdf]">
                  <span class="mt-0.5 w-7 shrink-0 font-mono text-[14px] text-slate-600">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-baseline gap-x-2">
                      <a
                        href={w.url}
                        target="_blank"
                        rel="noopener"
                        class="ulink font-mono text-[14px] font-medium text-slate-100"
                      >
                        {w.name}
                      </a>
                      {w.cat && (
                        <span class="rounded-[2px] border border-slate-800 px-1 font-mono text-[13px] text-slate-500">
                          {w.cat}
                        </span>
                      )}
                      {w.lang !== '—' && (
                        <span class="font-mono text-[14.5px] text-slate-600">{w.lang}</span>
                      )}
                    </div>
                    {noteOf(w.author, w.name) ? (
                      <p class="mt-0.5 line-clamp-1 text-[14px] leading-relaxed text-slate-400">
                        {noteOf(w.author, w.name)}
                      </p>
                    ) : (
                      w.desc && (
                        <p class="mt-0.5 line-clamp-1 text-[14.5px] leading-relaxed text-slate-500">
                          {w.desc}
                        </p>
                      )
                    )}
                    {audOf(w.author, w.name) && (
                      <p class="mt-1 line-clamp-1 border-l-2 border-[#b23a2b]/35 pl-2 text-[14px] leading-relaxed text-slate-500">
                        {audOf(w.author, w.name)}
                      </p>
                    )}
                    <div class="mt-1 flex items-center gap-2 font-mono text-[14.5px] text-slate-600 sm:hidden">
                      <a href={`${BASE}u/${w.author}/`} class="text-slate-400">@{w.author}</a>
                      <span>★{kfmt(w.stars)}</span>
                    </div>
                  </div>
                  <a
                    href={`${BASE}u/${w.author}/`}
                    class="hidden w-[120px] shrink-0 truncate font-mono text-[14px] text-slate-400 transition-colors hover:text-[#b23a2b] sm:block"
                  >
                    @{w.author}
                  </a>
                  <span class="hidden w-[70px] shrink-0 text-right font-mono text-[14.5px] text-slate-300 sm:block">
                    {kfmt(w.stars)}
                  </span>
                  <span class="hidden w-[60px] shrink-0 text-right font-mono text-[14.5px] text-slate-600 sm:block">
                    {w.updated.slice(2)}
                  </span>
                </li>
              ))}
            </ol>

            {g.items.length > LIMIT && (
              <details class="group/more border-t border-slate-800">
                <summary class="cursor-pointer list-none px-4 py-2.5 text-center font-mono text-[14px] text-slate-500 transition-colors hover:bg-[#f6efdf] hover:text-[#b23a2b]">
                  更多 {g.items.length - LIMIT} 件 ▾
                </summary>
                <ol class="divide-y divide-slate-800/60 border-t border-slate-800">
                  {g.items.slice(LIMIT).map((w, i) => (
                    <li class="flex items-start gap-3 px-4 py-2.5 transition-colors hover:bg-[#f6efdf]">
                      <span class="mt-0.5 w-7 shrink-0 font-mono text-[14px] text-slate-600">
                        {String(LIMIT + i + 1).padStart(2, '0')}
                      </span>
                      <div class="min-w-0 flex-1">
                        <a
                          href={w.url}
                          target="_blank"
                          rel="noopener"
                          class="ulink font-mono text-[14px] font-medium text-slate-100"
                        >
                          {w.name}
                        </a>
                        {noteOf(w.author, w.name) ? (
                          <p class="mt-0.5 line-clamp-1 text-[14px] leading-relaxed text-slate-400">
                            {noteOf(w.author, w.name)}
                          </p>
                        ) : (
                          w.desc && (
                            <p class="mt-0.5 line-clamp-1 text-[14.5px] leading-relaxed text-slate-500">
                              {w.desc}
                            </p>
                          )
                        )}
                      </div>
                      <a
                        href={`${BASE}u/${w.author}/`}
                        class="hidden w-[120px] shrink-0 truncate font-mono text-[14px] text-slate-400 transition-colors hover:text-[#b23a2b] sm:block"
                      >
                        @{w.author}
                      </a>
                      <span class="hidden w-[70px] shrink-0 text-right font-mono text-[14.5px] text-slate-300 sm:block">
                        {kfmt(w.stars)}
                      </span>
                    </li>
                  ))}
                </ol>
              </details>
            )}

            {/* 尾部：二级分类的完整清单（长尾专属） */}
            {g.subs.length > 0 && (
              <div class="border-t border-slate-800 px-4 py-3">
                <div class="labelmono mb-2">按细分查看</div>
                <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                  {g.subs.map((s) => (
                    <details class="rounded-[2px] border border-slate-800/80 bg-[#f6efdf]/50">
                      <summary class="flex cursor-pointer list-none items-baseline justify-between gap-2 px-3 py-2">
                        <span class="truncate text-[14.5px] text-slate-300">{s.name}</span>
                        <span class="shrink-0 font-mono text-[13px] text-slate-500">
                          {s.items.length} · ★{kfmt(s.stars)}
                        </span>
                      </summary>
                      <ol class="border-t border-slate-800/80">
                        {s.items.slice(0, 30).map((w) => (
                          <li class="flex items-baseline justify-between gap-2 px-3 py-1.5">
                            <a
                              href={w.url}
                              target="_blank"
                              rel="noopener"
                              class="truncate font-mono text-[14px] text-slate-400 hover:text-[#b23a2b]"
                              title={noteOf(w.author, w.name) || w.desc}
                            >
                              {w.name}
                            </a>
                            <span class="shrink-0 font-mono text-[14.5px] text-slate-600">
                              {kfmt(w.stars)}
                            </span>
                          </li>
                        ))}
                        {s.items.length > 30 && (
                          <li class="px-2.5 py-1 font-mono text-[14.5px] text-slate-600">
                            另有 {s.items.length - 30} 件
                          </li>
                        )}
                      </ol>
                    </details>
                  ))}
                </div>
              </div>
            )}
          </div>
        </details>
      ))
    }
  </section>

  <section class="wrap mt-10 grid gap-3 border-t border-slate-800 pt-6 sm:grid-cols-2">
    <a
      href={`${BASE}compare/`}
      class="group flex items-start justify-between gap-4 rounded-[2px] p-3 transition-colors hover:bg-[#fbf5e7]/70"
    >
      <div>
        <div class="labelmono">相关专题</div>
        <h3 class="mt-1 font-display text-[19px] font-semibold">同赛道怎么选</h3>
        <p class="mt-1 max-w-sm text-[14px] leading-relaxed text-slate-400">
          都能干同一件事的几个作品，差在哪、该选哪个——8 组真实替代关系。
        </p>
      </div>
      <span class="mt-1 shrink-0 font-mono text-sm text-slate-500 transition-transform duration-300 group-hover:translate-x-1"
        >→</span
      >
    </a>
    <a
      href={`${BASE}platforms/`}
      class="group flex items-start justify-between gap-4 rounded-[2px] p-3 transition-colors hover:bg-[#fbf5e7]/70"
    >
      <div>
        <div class="labelmono">相关专题</div>
        <h3 class="mt-1 font-display text-[19px] font-semibold">标准由谁定</h3>
        <p class="mt-1 max-w-sm text-[14px] leading-relaxed text-slate-400">
          上面「Skill 与知识库」那一类的格式，不是谁发明的——是三家标准制定者定的。
          去看看这 18 条标准分别管什么。
        </p>
      </div>
      <span class="mt-1 shrink-0 font-mono text-sm text-slate-500 transition-transform duration-300 group-hover:translate-x-1"
        >→</span
      >
    </a>
    <p class="self-center text-[14px] leading-[1.9] text-slate-500">
      一级分类依据仓库的 <code class="font-mono text-slate-400">layer</code> 字段（工具 / 应用 / Skill / 人格 / 生态…）。
      二级细分：对有语义标签的组用中文类（<span class="text-slate-400">category</span>）；
      「其他」组有 1,349 个不同仓库、没有统一标签，改按用途（站点与内容 / 配置与环境）与语言细分。
      只收录 <code class="font-mono text-slate-400">type=source</code> 仓库，排除 fork。
    </p>
  </section>
</BaseLayout>
