---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadWorks, groupStats, kfmt } from '../lib/works';
const BASE = import.meta.env.BASE_URL;

const works = loadWorks();
const groups = groupStats(works);
const totalStars = works.reduce((a, w) => a + w.stars, 0);
const totalNoted = works.filter((w) => w.note).length;
const authorCount = new Set(works.map((w) => w.author)).size;
---

<BaseLayout title="卷二 · 作品 · 星册" active="works">
  <section class="wrap pt-10 sm:pt-14">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b border-slate-800 pb-8">
      <div class="max-w-2xl">
        <div class="mb-4 flex items-center gap-3">
          <span class="seal">卷二 · 作品</span>
          <span class="labelmono">{works.length} 件</span>
        </div>
        <h1 class="display text-[2.4rem] sm:text-[3.4rem]">
          <span class="line-up"><span>他们造出来的东西</span></span>
        </h1>
        <p class="mt-4 text-[15px] leading-[1.9] text-slate-400">
          {works.length} 个作品分成 {groups.length} 类。先选一类，再看具体作品——
          每一类都标了件数、涉及多少位创作者，以及有多少写清了「这个作品解决什么」。
        </p>
      </div>
      <dl class="grid grid-cols-2 gap-x-8 gap-y-3 sm:grid-cols-4">
        <div>
          <dt class="labelmono">作品</dt>
          <dd class="font-mono text-[22px] leading-tight">{works.length}</dd>
        </div>
        <div>
          <dt class="labelmono">创作者</dt>
          <dd class="font-mono text-[22px] leading-tight">{authorCount}</dd>
        </div>
        <div>
          <dt class="labelmono">总星</dt>
          <dd class="font-mono text-[22px] leading-tight">{kfmt(totalStars)}</dd>
        </div>
        <div>
          <dt class="labelmono">有说明</dt>
          <dd class="font-mono text-[22px] leading-tight text-[#b23a2b]">{totalNoted}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 分类汇总卡 -->
  <section class="wrap mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      groups.map((g, i) => (
        <a
          href={`${BASE}works/${g.slug}/`}
          class="card stack-card reveal group flex flex-col p-0"
          style={`--stack-i:${i % 5}`}
        >
          <div class="flex items-start justify-between gap-3 border-b border-slate-800 px-5 py-4">
            <div class="min-w-0">
              <div class="labelmono">{String(i + 1).padStart(2, '0')} / {g.slug}</div>
              <h2 class="mt-1 font-display text-[20px] font-semibold leading-tight">{g.name}</h2>
            </div>
            <span
              class="shrink-0 rounded-[2px] px-2 py-1 font-mono text-[12px]"
              style={`background:${g.meta.accent}14;color:${g.meta.accent}`}
            >
              {g.meta.mark}
            </span>
          </div>

          <div class="flex flex-1 flex-col px-5 py-4">
            <p class="text-[13.5px] leading-[1.85] text-slate-400">{g.meta.blurb}</p>

            <dl class="mt-4 grid grid-cols-3 gap-3">
              <div>
                <dt class="labelmono">件数</dt>
                <dd class="font-mono text-[19px] leading-tight">{g.count}</dd>
              </div>
              <div>
                <dt class="labelmono">作者</dt>
                <dd class="font-mono text-[19px] leading-tight">{g.authors}</dd>
              </div>
              <div>
                <dt class="labelmono">星</dt>
                <dd class="font-mono text-[19px] leading-tight">{kfmt(g.stars)}</dd>
              </div>
            </dl>

            {g.top.length > 0 && (
              <div class="mt-4 border-t border-slate-800 pt-3">
                <div class="labelmono mb-2">主要子类</div>
                <div class="flex flex-wrap gap-1.5">
                  {g.top.map(([c, n]) => (
                    <span class="rounded-[2px] border border-slate-800 px-1.5 py-px text-[12px] text-slate-500">
                      {c} <span class="font-mono text-slate-600">{n}</span>
                    </span>
                  ))}
                </div>
              </div>
            )}

            <div class="mt-auto flex items-center justify-between pt-4 font-mono text-[12px] text-slate-500">
              <span>{g.noted > 0 ? `${g.noted} 件有说明` : '暂无说明'}</span>
              <span class="text-slate-400 transition-transform duration-300 group-hover:translate-x-1">
                进入 →
              </span>
            </div>
          </div>
          <span class="stamp">{g.count} 件</span>
        </a>
      ))
    }
  </section>

  <section class="wrap mt-10 grid gap-3 border-t border-slate-800 pt-6 sm:grid-cols-2">
    <a
      href={`${BASE}compare/`}
      class="group flex items-start justify-between gap-4 rounded-[2px] p-3 transition-colors hover:bg-[#fbf5e7]/70"
    >
      <div>
        <div class="labelmono">相关专题</div>
        <h3 class="mt-1 font-display text-[19px] font-semibold">同赛道怎么选</h3>
        <p class="mt-1 max-w-sm text-[13px] leading-relaxed text-slate-400">
          都能干同一件事的几个作品，差在哪、该选哪个——14 组真实替代关系。
        </p>
      </div>
      <span class="mt-1 shrink-0 font-mono text-sm text-slate-500 transition-transform duration-300 group-hover:translate-x-1"
        >→</span
      >
    </a>
    <a
      href={`${BASE}platforms/`}
      class="group flex items-start justify-between gap-4 rounded-[2px] p-3 transition-colors hover:bg-[#fbf5e7]/70"
    >
      <div>
        <div class="labelmono">相关专题</div>
        <h3 class="mt-1 font-display text-[19px] font-semibold">标准由谁定</h3>
        <p class="mt-1 max-w-sm text-[13px] leading-relaxed text-slate-400">
          「Skill 与知识库」那一类的格式不是谁发明的，是三家标准制定者定的。
        </p>
      </div>
      <span class="mt-1 shrink-0 font-mono text-sm text-slate-500 transition-transform duration-300 group-hover:translate-x-1"
        >→</span
      >
    </a>
  </section>
</BaseLayout>
