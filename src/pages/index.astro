---
import BaseLayout from '../layouts/BaseLayout.astro';
import Portrait from '../components/Portrait.astro';
import { getAllEntries, getPeopleProfiles } from '../lib/data';
import { kfmt } from '../lib/works';
const BASE = import.meta.env.BASE_URL;

const users = getAllEntries();
const profiles = getPeopleProfiles();
const creators = users.filter((u) => u.kind === 'creator');
const platforms = users.filter((u) => u.kind === 'platform');

const totalStars = creators.reduce((a, u) => a + u.stats.total_stars_source, 0);
const totalRepos = creators.reduce(
  (a, u) => a + u.repos.filter((r) => !r.fork).length,
  0
);
const totalSkills = creators.reduce((a, u) => a + (u.skills?.count || 0), 0);
const totalStandards = platforms.reduce((a, p) => a + (p.standards?.length || 0), 0);

// 精选：有简介的优先，其次按星数
const featured = [...creators]
  .sort((a, b) => {
    const az = profiles[a.profile.login] ? 0 : 1;
    const bz = profiles[b.profile.login] ? 0 : 1;
    return az - bz || b.stats.total_stars_source - a.stats.total_stars_source;
  })
  .slice(0, 8);

const maxStars = Math.max(...creators.map((c) => c.stats.total_stars_source), 1);

const entries = [
  {
    href: `${BASE}people/`,
    no: '卷一',
    title: '人物',
    sub: `${creators.length} 位创作者`,
    desc: '谁在做什么，他最值得学的一件事是什么，点开就是完整档案。',
    accent: 'var(--color-seal)',
    mark: '人',
  },
  {
    href: `${BASE}works/`,
    no: '卷二',
    title: '作品',
    sub: `${totalRepos.toLocaleString()} 个作品`,
    desc: '按类别收拢，每一件都写清「解决什么问题」与「适合谁用」。',
    accent: '#2f5d78',
    mark: '物',
  },
  {
    href: `${BASE}platforms/`,
    no: '卷三',
    title: '标准',
    sub: `${totalStandards} 条标准`,
    desc: '三家标准制定者定的规矩：skill 长什么样、装在哪、怎么被调用。',
    accent: '#4a6b4e',
    mark: '规',
  },
  {
    href: `${BASE}compare/`,
    no: '附录',
    title: '对比',
    sub: '14 组',
    desc: '同赛道真能互相替代的几个，差在哪、该选哪个。',
    accent: '#8a4b2a',
    mark: '较',
  },
];
---

<BaseLayout title="星册 · 高星创作者与他们的作品" active="home" theme="people">
  <!-- ================= 封面 ================= -->
  <section class="wrap pt-12 sm:pt-20">
    <div class="flex flex-wrap items-center gap-3">
      <span class="seal seal-drop">星册</span>
      <span class="labelmono">No.01 — 2026.10</span>
    </div>

    <h1 class="display mt-6 text-[2.9rem] leading-[0.94] sm:text-[5.2rem]">
      <span class="line-up"><span>高星创作者</span></span>
      <span class="line-up"
        ><span style="animation-delay:140ms"
          >和他们的<em class="not-italic text-[var(--color-seal)]">作品</em></span
        ></span
      >
    </h1>

    <div class="mt-8 grid gap-8 border-t border-slate-800 pt-8 lg:grid-cols-[1.4fr_1fr]">
      <p class="text-[16px] leading-[2] text-slate-400">
        一份持续更新的收录：<strong class="font-medium text-slate-200"
          >{creators.length} 位</strong
        >高星创作者、<strong class="font-medium text-slate-200">{totalRepos.toLocaleString()}</strong
        >件作品，以及<strong class="font-medium text-slate-200">{platforms.length} 家</strong
        >制定标准的平台方。
      </p>
      <p class="text-[14px] leading-[1.95] text-slate-500">
        不排星数名次，不堆仓库列表。每个收录对象都回答三件事：<span class="text-slate-300"
          >他是谁</span
        >、<span class="text-slate-300">代表作是哪个</span>、<span class="text-slate-300"
          >最值得学的一件事是什么</span
        >。
      </p>
    </div>

    <dl class="mt-10 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-slate-800 pt-8 sm:grid-cols-4">
      <div>
        <dt class="labelmono">创作者</dt>
        <dd class="mt-1 font-mono text-[30px] font-medium leading-none tracking-tight">
          {creators.length}
        </dd>
        <dd class="mt-1.5 text-[13px] text-slate-500">含中外各圈</dd>
      </div>
      <div>
        <dt class="labelmono">作品</dt>
        <dd class="mt-1 font-mono text-[30px] font-medium leading-none tracking-tight">
          {totalRepos.toLocaleString()}
        </dd>
        <dd class="mt-1.5 text-[13px] text-slate-500">仅 type=source，排除 fork</dd>
      </div>
      <div>
        <dt class="labelmono">Skills</dt>
        <dd class="mt-1 font-mono text-[30px] font-medium leading-none tracking-tight">
          {totalSkills}
        </dd>
        <dd class="mt-1.5 text-[13px] text-slate-500">可被 Agent 加载的条目</dd>
      </div>
      <div>
        <dt class="labelmono">总星</dt>
        <dd class="mt-1 font-mono text-[30px] font-medium leading-none tracking-tight">
          {kfmt(totalStars)}
        </dd>
        <dd class="mt-1.5 text-[13px] text-slate-500">快照值，带日期与口径</dd>
      </div>
    </dl>
  </section>

  <!-- ================= 四个入口 ================= -->
  <section class="wrap mt-16">
    <div class="mb-4 flex items-baseline justify-between gap-4 border-b border-slate-800 pb-2">
      <h2 class="font-display text-[19px] font-semibold">四卷</h2>
      <span class="labelmono">点选进入</span>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      {
        entries.map((e) => (
          <a
            href={e.href}
            class="group relative flex items-start gap-5 overflow-hidden rounded-[2px] border border-slate-800 bg-[var(--color-slate-900)]/55 p-5 transition-all duration-300 hover:border-[var(--color-slate-700)] hover:shadow-[0_18px_40px_-24px_rgba(23,20,15,0.4)]"
          >
            <span
              class="grid h-12 w-12 shrink-0 place-items-center rounded-[2px] font-display text-[19px] font-semibold"
              style={`background:${e.accent}16;color:${e.accent}`}
            >
              {e.mark}
            </span>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                <span class="labelmono">{e.no}</span>
                <h3 class="font-display text-[21px] font-semibold leading-tight">{e.title}</h3>
                <span class="font-mono text-[13px] text-slate-500">{e.sub}</span>
              </div>
              <p class="mt-1.5 text-[14px] leading-[1.85] text-slate-400">{e.desc}</p>
            </div>

            <span class="mt-1 shrink-0 font-mono text-sm text-slate-500 transition-transform duration-300 group-hover:translate-x-1">
              →
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ================= 精选人物 ================= -->
  <section class="wrap mt-16">
    <div class="mb-4 flex items-baseline justify-between gap-4 border-b border-slate-800 pb-2">
      <h2 class="font-display text-[19px] font-semibold">先看这几位</h2>
      <a href={`${BASE}people/`} class="labelmono ulink">全部 {creators.length} 位 →</a>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      {
        featured.map((u) => {
          const p = profiles[u.profile.login];
          const accent =
            u.profile.strategy === 'depth'
              ? '#7a4a2e'
              : u.profile.strategy === 'breadth'
                ? '#3f5a72'
                : '#4a6b4e';
          return (
            <a
              href={`${BASE}u/${u.profile.login}/`}
              class="group flex flex-col items-center rounded-[2px] border border-slate-800 bg-[var(--color-slate-900)]/55 p-4 transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-slate-700)] hover:shadow-[0_16px_34px_-22px_rgba(23,20,15,0.45)]"
            >
              <Portrait
                login={u.profile.login}
                name={u.profile.name}
                size={72}
                progress={u.stats.total_stars_source / maxStars}
                ring="solid"
                accent={accent}
              />
              <h3 class="mt-3 w-full truncate text-center font-display text-[15px] font-semibold">
                {u.profile.name}
              </h3>
              <div class="mt-0.5 font-mono text-[12px] text-slate-500">@{u.profile.login}</div>
              <p class="mt-1.5 line-clamp-2 text-center text-[12.5px] leading-[1.65] text-slate-400">
                {p?.tagline || '—'}
              </p>
              <div class="mt-2 font-mono text-[12px] text-slate-500">
                ★{kfmt(u.stats.total_stars_source)}
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- ================= 页脚说明 ================= -->
  <section class="wrap mt-16 border-t border-slate-800 pt-6">
    <p class="max-w-2xl text-[13px] leading-[1.95] text-slate-500">
      全部数据来自 GitHub 公开 API 快照，星数为 <code class="font-mono text-slate-400">type=source</code> 仓库合计、排除 fork。
      每个数字带日期与口径，方法与边界写在 <a href={`${BASE}about/`} class="ulink">关于</a> 里。
    </p>
  </section>
</BaseLayout>
