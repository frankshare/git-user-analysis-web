---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import { getAllUsers } from '../lib/data';
const BASE = import.meta.env.BASE_URL;

const users = getAllUsers();

const num = (v: unknown) => (typeof v === 'number' ? v : parseInt(String(v ?? 0), 10) || 0);
const CJK = '一-龥';
const hasCjk = (s: string) => new RegExp('[' + CJK + ']').test(s || '');

type Row = {
  login: string;
  name: string;
  bio: string;
  x: string;
  website: string;
  stars: number;
  median: number;
  top4: number;
  strategy: string;
  zh: boolean;
  works: { name: string; stars: number; desc: string; layer: string }[];
  skillCount: number;
};

const rows: Row[] = users
  .map((u) => {
    const works = (u.repos || [])
      .filter((r) => !r.fork)
      .map((r) => ({
        name: r.name,
        stars: num(r.stars),
        desc: r.description || '',
        layer: (r as any).layer || '',
      }))
      .sort((a, b) => b.stars - a.stars);
    const sample = (u.repos || []).filter((r) => !r.fork).slice(0, 20);
    const zhDescRatio = sample.length
      ? sample.filter((r) => hasCjk(r.description || '')).length / sample.length
      : 0;
    return {
      login: u.profile.login,
      name: u.profile.name || u.profile.login,
      bio: u.profile.bio || '',
      x: u.profile.x || '',
      website: u.profile.website || '',
      stars: num(u.stats.total_stars_source),
      median: num(u.stats.median_stars),
      top4: num(u.stats.top4_share),
      strategy: u.profile.strategy || 'hybrid',
      zh: hasCjk(u.profile.name || '') || zhDescRatio >= 0.25,
      works,
      skillCount: u.skills?.count || 0,
    };
  })
  .sort((a, b) => b.stars - a.stars);

const totalStars = rows.reduce((a, r) => a + r.stars, 0);
const totalWorks = rows.reduce((a, r) => a + r.works.length, 0);
const totalSkills = rows.reduce((a, r) => a + r.skillCount, 0);
const zhCount = rows.filter((r) => r.zh).length;

const strategyLabel: Record<string, string> = {
  depth: '单点深挖',
  breadth: '矩阵铺开',
  hybrid: '两者兼有',
};

const top = rows[0];
const rest = rows.slice(1);

const fmt = (n: number) => n.toLocaleString('en-US');
const kfmt = (n: number) =>
  n >= 10000 ? `${(n / 10000).toFixed(1).replace('.0', '')}w` : fmt(n);
---

<BaseLayout title="星册 · 高星创作者档案馆" active="people">
  <!-- ============ 封面 ============ -->
  <section class="wrap pt-10 sm:pt-16">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b border-slate-800 pb-8">
      <div class="max-w-2xl">
        <div class="mb-5 flex items-center gap-3">
          <span class="seal seal-drop">卷一 · 人物</span>
          <span class="labelmono">No.01 — 2026.10</span>
        </div>

        <h1 class="display text-[2.7rem] leading-[0.95] sm:text-[4.1rem]">
          <span class="line-up"><span style="animation-delay:60ms">高星创作者</span></span>
          <span class="line-up"
            ><span style="animation-delay:150ms"
              >都在<em class="not-italic text-[#b23a2b]">做</em>什么</span
            ></span
          >
        </h1>

        <p class="mt-5 max-w-xl text-[15px] leading-[1.85] text-slate-400">
          收录 <strong class="font-medium text-slate-200">{rows.length} 位</strong>创作者与他们的作品。
          不看排行榜名次，看三件事：<span class="text-slate-200">他是谁</span>、<span class="text-slate-200"
            >代表作是哪个</span
          >、<span class="text-slate-200">往哪看</span>。点开卡片，就是这个人的完整档案。
        </p>
      </div>

      <!-- 索引数字 -->
      <dl class="grid w-full grid-cols-2 gap-x-8 gap-y-4 sm:w-auto sm:grid-cols-4 sm:gap-x-10">
        {
          [
            ['创作者', fmt(rows.length), `中文作品 ${zhCount} / 英文 ${rows.length - zhCount}`],
            ['作品', fmt(totalWorks), 'source 仓库'],
            ['Skills', fmt(totalSkills), '可复用技能条目'],
            ['总星数', kfmt(totalStars), '合计，排除 fork'],
          ].map(([k, v, s]) => (
            <div>
              <dt class="labelmono">{k}</dt>
              <dd class="font-mono text-[26px] font-medium leading-tight tracking-tight">{v}</dd>
              <dd class="mt-0.5 text-[11px] text-slate-500">{s}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ============ 筛选 ============ -->
  <section class="wrap sticky top-14 z-10 -mx-0 bg-[#f2e9d6]/92 py-3 backdrop-blur-sm">
    <div class="flex items-center gap-1.5 overflow-x-auto whitespace-nowrap [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <span class="labelmono mr-2 shrink-0">筛选</span>
      {
        [
          ['all', '全部'],
          ['zh', '中文作品'],
          ['en', '英文作品'],
          ['depth', '单点深挖'],
          ['breadth', '矩阵铺开'],
          ['hybrid', '两者兼有'],
        ].map(([key, label], i) => (
          <button
            type="button"
            data-filter={key}
            class:list={[
              'shrink-0 rounded-[2px] border px-3 py-1 text-[13px] transition-colors',
              i === 0
                ? 'border-[#b23a2b] bg-[#b23a2b] text-[#fbf5e7]'
                : 'border-slate-800 text-slate-400 hover:border-slate-600 hover:text-slate-200',
            ]}
          >
            {label}
          </button>
        ))
      }
      <span class="ml-auto hidden shrink-0 font-mono text-[11px] text-slate-500 sm:block" id="count"></span>
    </div>
  </section>

  <!-- ============ 画廊 ============ -->
  <section class="wrap mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <!-- 首位：加大卡 -->
    <a
      href={`${BASE}u/${top.login}/`}
      class="card reveal group sm:col-span-2"
      data-key={`${top.zh ? 'zh' : 'en'} ${top.strategy}`}
      style="padding:1.5rem 1.5rem 1.3rem 1.8rem"
    >
      <div class="flex items-start gap-5">
        <Avatar login={top.login} name={top.name} size={96} eager class="rounded-[3px]" />
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2">
            <span class="labelmono">001 · 星最多的那位</span>
            <span class="seal">首卷</span>
          </div>
          <h2 class="mt-1 truncate font-display text-[26px] font-semibold leading-tight">
            {top.name}
          </h2>
          <div class="mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] text-slate-500">
            <span>@{top.login}</span>
            <span class="text-[#b23a2b]">{strategyLabel[top.strategy] ?? top.strategy}</span>
            {top.x && <span class="text-slate-400">X ↗</span>}
          </div>
          <p class="mt-2 line-clamp-2 text-[13.5px] leading-[1.75] text-slate-400">{top.bio}</p>
        </div>
        <div class="shrink-0 text-right">
          <div class="font-mono text-[30px] font-medium leading-none tracking-tight">
            {kfmt(top.stars)}
          </div>
          <div class="labelmono mt-1">stars</div>
        </div>
      </div>

      <div class="mt-5 grid gap-2 sm:grid-cols-3">
        {
          top.works.slice(0, 3).map((w, i) => (
            <div class="rounded-[2px] border border-slate-800 bg-[#f6efdf]/60 px-3 py-2">
              <div class="flex items-baseline justify-between gap-2">
                <span class="truncate font-mono text-[12px] text-slate-200">
                  {String(i + 1).padStart(2, '0')} {w.name}
                </span>
                <span class="shrink-0 font-mono text-[11px] text-[#b23a2b]">★{kfmt(w.stars)}</span>
              </div>
              <p class="mt-1 line-clamp-2 text-[11.5px] leading-snug text-slate-500">{w.desc}</p>
            </div>
          ))
        }
      </div>
      <span class="stamp">已收录</span>
    </a>

    <!-- 其余 -->
    {
      rest.map((r, i) => (
        <a
          href={`${BASE}u/${r.login}/`}
          class="card reveal group"
          data-key={`${r.zh ? 'zh' : 'en'} ${r.strategy}`}
        >
          <div class="flex items-start gap-3.5">
            <Avatar login={r.login} name={r.name} size={52} class="rounded-[2px]" />
            <div class="min-w-0 flex-1">
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="truncate font-display text-[17px] font-semibold leading-tight">
                  {r.name}
                </h3>
                <span class="shrink-0 font-mono text-[12px] text-slate-400">★{kfmt(r.stars)}</span>
              </div>
              <div class="mt-0.5 flex items-center gap-2 font-mono text-[10.5px] text-slate-500">
                <span class="text-slate-600">{String(i + 2).padStart(3, '0')}</span>
                <span class="truncate">@{r.login}</span>
                <span class="text-[#b23a2b]">·</span>
                <span class="shrink-0 text-[#b23a2b]">{strategyLabel[r.strategy] ?? r.strategy}</span>
              </div>
            </div>
          </div>

          <p class="mt-2.5 line-clamp-2 text-[12.5px] leading-[1.7] text-slate-400">{r.bio}</p>

          <div class="mt-3 space-y-1 border-t border-slate-800 pt-2.5">
            {r.works.slice(0, 2).map((w) => (
              <div class="flex items-baseline justify-between gap-2">
                <span class="truncate font-mono text-[11.5px] text-slate-300">{w.name}</span>
                <span class="shrink-0 font-mono text-[10.5px] text-slate-500">★{kfmt(w.stars)}</span>
              </div>
            ))}
            {r.works.length === 0 && (
              <div class="font-mono text-[11px] text-slate-600">— 无 source 仓库 —</div>
            )}
          </div>

          <div class="mt-2.5 flex items-center justify-between font-mono text-[10px] text-slate-500">
            <span>{r.skillCount > 0 ? `${r.skillCount} skills` : `${r.works.length} repos`}</span>
            <span class="opacity-0 transition-opacity duration-300 group-hover:opacity-100">
              打开档案 →
            </span>
          </div>
          <span class="stamp">已收录</span>
        </a>
      ))
    }
  </section>

  <!-- ============ 两条去路 ============ -->
  <section class="wrap mt-14 grid gap-4 border-t border-slate-800 pt-8 sm:grid-cols-2">
    <a
      href={`${BASE}works/`}
      class="group flex items-start justify-between gap-4 rounded-[2px] p-2 transition-colors hover:bg-[#fbf5e7]/70"
    >
      <div>
        <div class="labelmono">卷二</div>
        <h3 class="mt-1 font-display text-[22px] font-semibold">作品</h3>
        <p class="mt-1 max-w-sm text-[13px] leading-relaxed text-slate-400">
          不按人看，按作品看：{fmt(totalWorks)} 个 source 仓库，按星数排，标着作者与语言。
        </p>
      </div>
      <span class="mt-1 shrink-0 font-mono text-sm text-slate-500 transition-transform duration-300 group-hover:translate-x-1"
        >→</span
      >
    </a>
    <a
      href={`${BASE}research/`}
      class="group flex items-start justify-between gap-4 rounded-[2px] p-2 transition-colors hover:bg-[#fbf5e7]/70"
    >
      <div>
        <div class="labelmono">附录</div>
        <h3 class="mt-1 font-display text-[22px] font-semibold">研究</h3>
        <p class="mt-1 max-w-sm text-[13px] leading-relaxed text-slate-400">
          拆解过程中的副产品：方法收敛、自查清单、SKILL.md 格式实测。想看方法论的进这里。
        </p>
      </div>
      <span class="mt-1 shrink-0 font-mono text-sm text-slate-500 transition-transform duration-300 group-hover:translate-x-1"
        >→</span
      >
    </a>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLAnchorElement>('.card[data-key]');
    const count = document.getElementById('count');

    function apply(key: string) {
      let n = 0;
      cards.forEach((c) => {
        const k = c.dataset.key || '';
        const show = key === 'all' || k.split(' ').includes(key);
        c.style.display = show ? '' : 'none';
        if (show) n++;
      });
      if (count) count.textContent = `${n} / ${cards.length}`;
    }

    buttons.forEach((b) => {
      b.addEventListener('click', () => {
        buttons.forEach((x) => {
          x.classList.remove('border-[#b23a2b]', 'bg-[#b23a2b]', 'text-[#fbf5e7]');
          x.classList.add('border-slate-800', 'text-slate-400');
        });
        b.classList.remove('border-slate-800', 'text-slate-400');
        b.classList.add('border-[#b23a2b]', 'bg-[#b23a2b]', 'text-[#fbf5e7]');
        apply(b.dataset.filter || 'all');
      });
    });
    apply('all');
  </script>
</BaseLayout>
