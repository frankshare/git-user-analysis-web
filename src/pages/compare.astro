---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
const BASE = import.meta.env.BASE_URL;

const cFile = path.resolve('src/data/work-comparisons.json');
const notesFile = path.resolve('src/data/work-notes.json');
const C = fs.existsSync(cFile) ? JSON.parse(fs.readFileSync(cFile, 'utf-8')) : { groups: [] };
const N = fs.existsSync(notesFile) ? JSON.parse(fs.readFileSync(notesFile, 'utf-8')) : {};

const noteOf = (key: string) => {
  const [a, r] = key.split('/');
  return N[a]?.[r] || '';
};

// 对比组按「可替代程度」排序：真替代关系的排前面
const groups = [...C.groups].sort((a, b) => b.items.length - a.items.length);
---

<BaseLayout title="横向对比 · 星册" active="research"
  note="对比只在同一任务、真正能互相替代的作品之间做；上下游关系与同源系列单独标注，不混为一谈。">
  <section class="wrap pt-10 sm:pt-14">
    <div class="border-b border-slate-800 pb-8">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <span class="seal">专题 · 横向对比</span>
        <span class="labelmono">{groups.length} 组 · {groups.reduce((a, g) => a + g.items.length, 0)} 个作品</span>
      </div>
      <h1 class="display text-[2.2rem] sm:text-[3.1rem]">
        <span class="line-up"><span>同赛道，怎么选</span></span>
      </h1>
      <p class="mt-4 max-w-2xl text-[14.5px] leading-[1.85] text-slate-400">
        收录了 300 个作品之后，新的问题不是「有哪些」，而是「这几个都能干这事，该选哪个」。
        这里只对比<strong class="text-slate-200">同一任务、真正能互相替代</strong>的作品——
        上下游关系和同源系列会标出来，不混为一谈。
      </p>
      <p class="mt-3 max-w-2xl text-[12.5px] leading-[1.85] text-slate-500">
        筛选口径：① 必须同属一个任务域（都在做记忆、都在做幻灯片…）；② 存在真实替代关系（换用另一个也说得通）；
        ③ 规模差距不过大（一方完全碾压的不算「选型」）。三者缺一不收。
      </p>
    </div>
  </section>

  <section class="wrap mt-6 space-y-4">
    {
      groups.map((g, gi) => (
        <article class="overflow-hidden rounded-[2px] border border-slate-800 bg-[#fbf5e7]/55">
          <header class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-slate-800 px-5 py-3.5">
            <span class="font-mono text-[11px] text-slate-600">{String(gi + 1).padStart(2, '0')}</span>
            <h2 class="font-display text-[19px] font-semibold">{g.title}</h2>
            <span class="text-[12.5px] text-slate-500">问：{g.question}</span>
            <span class="ml-auto font-mono text-[10.5px] text-slate-500">{g.items.length} 个候选</span>
          </header>

          <div class="divide-y divide-slate-800/60">
            {g.items.map((it) => (
              <div class="grid gap-2 px-5 py-3 sm:grid-cols-[150px_1fr] sm:gap-4">
                <div class="min-w-0">
                  <a
                    href={`${BASE}u/${it.key.split('/')[0]}/`}
                    class="font-mono text-[12.5px] text-slate-100 hover:text-[#b23a2b]"
                  >
                    {it.key.split('/')[1]}
                  </a>
                  <div class="mt-0.5 font-mono text-[10.5px] text-slate-600">
                    @{it.key.split('/')[0]}
                  </div>
                  <div class="mt-1.5 inline-block rounded-[2px] border border-slate-800 px-1.5 py-px text-[10.5px] text-slate-500">
                    {it.role}
                  </div>
                </div>
                <div class="min-w-0">
                  {noteOf(it.key) && (
                    <p class="text-[12.5px] leading-relaxed text-slate-400">{noteOf(it.key)}</p>
                  )}
                  <p class="mt-1 border-l-2 border-[#b23a2b]/40 pl-2.5 text-[12.5px] leading-[1.8] text-slate-500">
                    {it.diff}
                  </p>
                </div>
              </div>
            ))}
          </div>

          <footer class="border-t border-slate-800 bg-[#f6efdf]/70 px-5 py-3">
            <div class="flex items-start gap-2.5">
              <span class="mt-[3px] shrink-0 font-mono text-[10px] text-[#b23a2b]">结论</span>
              <p class="text-[13px] leading-[1.85] text-slate-200">{g.verdict}</p>
            </div>
          </footer>
        </article>
      ))
    }
  </section>

  <section class="wrap mt-10 border-t border-slate-800 pt-6">
    <p class="max-w-2xl text-[12.5px] leading-[1.9] text-slate-500">
      说明：每条「差异」都基于该作者在本站的五问拆解与跨仓方法归纳，不是通用印象；
      涉及星数与占比的数字为快照值。同一作品可能出现在多组里——这本身也是信号：
      <strong class="text-slate-300">被多个任务域收录的，是覆盖面广的作品；只在一组里的，是专精型。</strong>
    </p>
  </section>
</BaseLayout>
