---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadWorks, groupStats, kfmt } from '../../lib/works';
const BASE = import.meta.env.BASE_URL;

export function getStaticPaths() {
  return groupStats(loadWorks()).map((g) => ({ params: { group: g.slug }, props: { slug: g.slug } }));
}

const { slug } = Astro.props;
const works = loadWorks();
const groups = groupStats(works);
const g = groups.find((x) => x.slug === slug);

if (!g) {
  return Astro.redirect(`${BASE}works/`);
}

const idx = groups.findIndex((x) => x.slug === slug);
const prev = groups[idx - 1];
const next = groups[idx + 1];
---

<BaseLayout title={`${g.name} · 作品 · 星册`} active="works" theme="works">
  <section class="wrap pt-8 sm:pt-12">
    <a href={`${BASE}works/`} class="labelmono ulink">← 回作品总览</a>

    <div class="mt-4 flex flex-wrap items-end justify-between gap-6 border-b border-slate-800 pb-7">
      <div class="max-w-2xl">
        <div class="mb-3 flex items-center gap-3">
          <span
            class="rounded-[2px] px-2 py-1 font-mono text-[12px]"
            style={`background:${g.meta.accent}14;color:${g.meta.accent}`}
            >{g.meta.mark}</span
          >
          <span class="labelmono">卷二 · {String(idx + 1).padStart(2, '0')} / {g.slug}</span>
        </div>
        <h1 class="display text-[2.2rem] sm:text-[3rem]">
          <span class="line-up"><span>{g.name}</span></span>
        </h1>
        <p class="mt-3 text-[14.5px] leading-[1.9] text-slate-400">{g.meta.blurb}</p>
      </div>
      <dl class="grid grid-cols-2 gap-x-8 gap-y-3 sm:grid-cols-4">
        <div>
          <dt class="labelmono">件数</dt>
          <dd class="font-mono text-[22px] leading-tight">{g.count}</dd>
        </div>
        <div>
          <dt class="labelmono">作者</dt>
          <dd class="font-mono text-[22px] leading-tight">{g.authors}</dd>
        </div>
        <div>
          <dt class="labelmono">总星</dt>
          <dd class="font-mono text-[22px] leading-tight">{kfmt(g.stars)}</dd>
        </div>
        <div>
          <dt class="labelmono">有说明</dt>
          <dd class="font-mono text-[22px] leading-tight text-[var(--color-seal)]">{g.noted}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 筛选 -->
  <section class="wrap sticky top-14 z-10 bg-[var(--color-slate-950)]/92 py-3 backdrop-blur-sm">
    <div class="flex flex-wrap items-center gap-2">
      <span class="labelmono mr-1">筛选</span>
      <button
        type="button"
        data-f="all"
        class="rounded-[2px] border border-[var(--color-seal)] bg-[var(--color-seal)] px-2.5 py-1 text-[13px] text-[var(--color-slate-900)] transition-colors"
        >全部</button
      >
      <button
        type="button"
        data-f="noted"
        class="rounded-[2px] border border-slate-800 px-2.5 py-1 text-[13px] text-slate-400 transition-colors hover:border-slate-600 hover:text-slate-200"
        >有说明</button
      >
      <button
        type="button"
        data-f="big"
        class="rounded-[2px] border border-slate-800 px-2.5 py-1 text-[13px] text-slate-400 transition-colors hover:border-slate-600 hover:text-slate-200"
        >千星以上</button
      >
      <button
        type="button"
        data-f="zh"
        class="rounded-[2px] border border-slate-800 px-2.5 py-1 text-[13px] text-slate-400 transition-colors hover:border-slate-600 hover:text-slate-200"
        >中文作者</button
      >
      {
        g.subs.length > 0 && (
          <span class="ml-1 hidden items-center gap-1.5 sm:flex">
            {g.subs.slice(0, 4).map((s) => (
              <span class="rounded-[2px] border border-slate-800 px-2 py-0.5 text-[12px] text-slate-500">
                {s.name} <span class="font-mono text-slate-600">{s.count}</span>
              </span>
            ))}
          </span>
        )
      }
      <input
        id="q"
        type="search"
        placeholder="搜作品名 / 描述 / 作者…"
        class="ml-auto w-full max-w-[240px] rounded-[2px] border border-slate-800 bg-[var(--color-slate-900)] px-3 py-1.5 text-[13px] text-slate-200 placeholder:text-slate-500 focus:border-[var(--color-seal)] focus:outline-none"
      />
      <span class="font-mono text-[12px] text-slate-500" id="cnt"></span>
    </div>
  </section>

  <!-- 作品列表 -->
  <section class="wrap mt-4">
    <ol id="list" class="divide-y divide-slate-800/60">
      {
        g.items.map((w, i) => (
          <li
            class="row group flex items-start gap-4 py-3.5 transition-colors hover:bg-[var(--color-slate-950)]/70"
            data-k={`${w.note ? 'noted ' : ''}${w.stars >= 1000 ? 'big ' : ''}${w.zh ? 'zh' : ''}`}
            data-s={`${w.name} ${w.desc} ${w.author} ${w.authorName} ${w.note}`.toLowerCase()}
          >
            <span class="mt-1 w-8 shrink-0 font-mono text-[12px] text-slate-600">
              {String(i + 1).padStart(2, '0')}
            </span>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                <a
                  href={w.url}
                  target="_blank"
                  rel="noopener"
                  class="ulink font-mono text-[14px] font-medium text-slate-100"
                >
                  {w.name}
                </a>
                {w.cat && (
                  <span class="rounded-[2px] border border-slate-800 px-1.5 py-px font-mono text-[12px] text-slate-500">
                    {w.cat}
                  </span>
                )}
                {w.lang !== '—' && (
                  <span class="font-mono text-[12px] text-slate-600">{w.lang}</span>
                )}
              </div>

              {w.note ? (
                <p class="mt-1 text-[14px] leading-[1.8] text-slate-400">{w.note}</p>
              ) : (
                w.desc && <p class="mt-1 line-clamp-1 text-[13px] leading-relaxed text-slate-500">{w.desc}</p>
              )}

              {w.audience && (
                <p class="mt-1.5 border-l-2 border-[var(--color-seal)]/40 pl-2.5 text-[13px] leading-[1.75] text-slate-500">
                  {w.audience}
                </p>
              )}
            </div>

            <div class="hidden shrink-0 text-right sm:block">
              <a
                href={`${BASE}u/${w.author}/`}
                class="block w-[130px] truncate font-mono text-[12.5px] text-slate-400 transition-colors hover:text-[var(--color-seal)]"
              >
                @{w.author}
              </a>
              <div class="mt-0.5 font-mono text-[14px] text-slate-300">★{kfmt(w.stars)}</div>
              <div class="font-mono text-[13px] text-slate-600">{w.updated.slice(2)}</div>
            </div>

            <div class="flex shrink-0 items-center gap-2 font-mono text-[12px] text-slate-600 sm:hidden">
              <span>★{kfmt(w.stars)}</span>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="hidden py-4 text-center font-mono text-[13px] text-slate-500" id="empty">没有匹配的作品</p>
  </section>

  <!-- 上下类 -->
  <section class="wrap mt-10 grid gap-3 border-t border-slate-800 pt-6 sm:grid-cols-2">
    {
      prev ? (
        <a
          href={`${BASE}works/${prev.slug}/`}
          class="group flex items-center justify-between gap-3 rounded-[2px] p-3 transition-colors hover:bg-[var(--color-slate-900)]/70"
        >
          <span class="font-mono text-sm text-slate-500 transition-transform duration-300 group-hover:-translate-x-1">←</span>
          <span class="text-right">
            <span class="labelmono block">上一类</span>
            <span class="font-display text-[17px] font-semibold">{prev.name}</span>
          </span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a
          href={`${BASE}works/${next.slug}/`}
          class="group flex items-center justify-between gap-3 rounded-[2px] p-3 transition-colors hover:bg-[var(--color-slate-900)]/70"
        >
          <span>
            <span class="labelmono block">下一类</span>
            <span class="font-display text-[17px] font-semibold">{next.name}</span>
          </span>
          <span class="font-mono text-sm text-slate-500 transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
      ) : (
        <span />
      )
    }
  </section>

  <script>
    // View Transitions 下脚本只执行一次，必须挂到 astro:page-load 上重新绑定
    function initList() {
    const btns = document.querySelectorAll<HTMLButtonElement>('[data-f]');
    const rows = Array.from(document.querySelectorAll<HTMLLIElement>('.row'));
    const q = document.getElementById('q') as HTMLInputElement | null;
    const cnt = document.getElementById('cnt');
    const empty = document.getElementById('empty');
    let cur = 'all';

    function run() {
      const s = (q?.value || '').trim().toLowerCase();
      let n = 0;
      rows.forEach((r) => {
        const keys = (r.dataset.k || '').split(' ');
        const okF = cur === 'all' || keys.includes(cur);
        const okQ = !s || (r.dataset.s || '').includes(s);
        const show = okF && okQ;
        r.style.display = show ? '' : 'none';
        if (show) n++;
      });
      if (cnt) cnt.textContent = `${n} / ${rows.length}`;
      if (empty) empty.classList.toggle('hidden', n > 0);
    }

    btns.forEach((b) =>
      b.addEventListener('click', () => {
        btns.forEach((x) => {
          x.classList.remove('border-[var(--color-seal)]', 'bg-[var(--color-seal)]', 'text-[var(--color-slate-900)]');
          x.classList.add('border-slate-800', 'text-slate-400');
        });
        b.classList.remove('border-slate-800', 'text-slate-400');
        b.classList.add('border-[var(--color-seal)]', 'bg-[var(--color-seal)]', 'text-[var(--color-slate-900)]');
        cur = b.dataset.f || 'all';
        run();
      })
    );
    q?.addEventListener('input', run);
    run();
    }
    // 立即执行一次（astro:page-load 可能在监听器注册前就已派发），
    // 换页回来时再执行一次。DOM 每次都是新的，所以不会重复绑定。
    initList();
    document.addEventListener('astro:page-load', initList);
  </script>
</BaseLayout>
