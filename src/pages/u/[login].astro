---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Avatar from '../../components/Avatar.astro';
import { getAllEntries, type Entry } from '../../lib/data';
import { ROLE_LABELS } from '../../lib/orgs';
const BASE = import.meta.env.BASE_URL;

export function getStaticPaths() {
  return getAllEntries().map((u) => ({ params: { login: u.profile.login }, props: { user: u } }));
}

interface Props {
  user: Entry;
}
const { user } = Astro.props;
const isPlatform = user.kind === 'platform';
const role = isPlatform ? ROLE_LABELS[user.profile.platform_role || 'community_hub'] : null;

const p = user.profile;
const s = user.stats;
const num = (v: unknown) => (typeof v === 'number' ? v : parseInt(String(v ?? 0), 10) || 0);
const isDepth = p.strategy === 'depth';
const strategyLabel =
  p.strategy === 'depth' ? '单点深挖' : p.strategy === 'breadth' ? '矩阵铺开' : '两者兼有';

const sourceRepos = user.repos
  .filter((r) => !r.fork)
  .map((r) => ({ ...r, stars: num(r.stars) }))
  .sort((a, b) => b.stars - a.stars);

const topRepos = sourceRepos.slice(0, 20);

const byCategory = new Map<string, number>();
for (const r of sourceRepos) {
  const c = (r as any).category || '其他';
  byCategory.set(c, (byCategory.get(c) || 0) + 1);
}
const cats = [...byCategory.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);

const buckets = [
  { label: '≥1000', n: num(s.ge_1000), hot: true },
  { label: '100–999', n: num(s.between_100_999) },
  { label: '10–99', n: num(s.between_10_99) },
  { label: '<10', n: num(s.lt_10) },
];
const maxBucket = Math.max(...buckets.map((b) => b.n), 1);

const skills = user.skills?.items || [];
const analyses = user.skill_analyses || [];
const patterns = user.patterns || [];

const kfmt = (n: number) =>
  n >= 10000 ? `${(n / 10000).toFixed(1).replace('.0', '')}w` : n.toLocaleString('en-US');

const allEntries = getAllEntries();
const rank = allEntries
  .map((u) => ({ login: u.profile.login, stars: num(u.stats.total_stars_source) }))
  .sort((a, b) => b.stars - a.stars)
  .findIndex((u) => u.login === p.login);
const idx = String(rank + 1).padStart(3, '0');
const totalEntries = allEntries.length;
const standards = user.standards || [];

const links = [
  { href: `https://github.com/${p.login}`, label: 'GitHub', show: true },
  { href: p.x, label: 'X', show: !!p.x },
  { href: p.website, label: (p.website || '').replace('https://', '').replace('http://', '') || '网站', show: !!p.website },
  {
    href: (p as any).bilibili,
    label: 'B站',
    show: !!(p as any).bilibili,
  },
].filter((l) => l.show && l.href);
---

<BaseLayout title={`${p.name}（@${p.login}）· 星册`} description={p.bio} active="people">
  <section class="wrap pt-6">
    <a href={`${BASE}`} class="labelmono ulink inline-flex items-center gap-1">← 回人物画廊</a>
  </section>

  <!-- 分段导航 -->
  {
    !isPlatform && (
      <nav class="wrap mt-5 flex flex-wrap items-center gap-1.5 border-b border-slate-800 pb-3">
        <span class="labelmono mr-1">本档案</span>
        <a href="#works" class="rounded-[2px] border border-slate-800 px-2.5 py-1 text-[12px] text-slate-400 transition-colors hover:border-[#b23a2b] hover:text-[#b23a2b]">
          作品 {sourceRepos.length}
        </a>
        {skills.length > 0 && (
          <a href="#skills" class="rounded-[2px] border border-slate-800 px-2.5 py-1 text-[12px] text-slate-400 transition-colors hover:border-[#b23a2b] hover:text-[#b23a2b]">
            Skills {skills.length}
          </a>
        )}
        {patterns.length > 0 && (
          <a href="#methods" class="rounded-[2px] border border-slate-800 px-2.5 py-1 text-[12px] text-slate-400 transition-colors hover:border-[#b23a2b] hover:text-[#b23a2b]">
            方法 {patterns.length}
          </a>
        )}
        {analyses.length > 0 && (
          <a href="#dive" class="rounded-[2px] border border-slate-800 px-2.5 py-1 text-[12px] text-slate-400 transition-colors hover:border-[#b23a2b] hover:text-[#b23a2b]">
            深度拆解 {analyses.length}
          </a>
        )}
        {isPlatform && (
          <a href="#standards" class="rounded-[2px] border border-slate-800 px-2.5 py-1 text-[12px] text-slate-400 transition-colors hover:border-[#b23a2b] hover:text-[#b23a2b]">
            标准 {standards.length}
          </a>
        )}
      </nav>
    )
  }

  <!-- 档案头 -->
  <section class="wrap mt-4">
    <div class="flex flex-col gap-6 border-b border-slate-800 pb-8 sm:flex-row sm:items-start">
      <span class="relative shrink-0">
        <span
          class="pointer-events-none absolute -inset-[8px] rounded-full border border-[#cbbb95]"
          aria-hidden="true"
        >
        </span>
        <Avatar
          login={p.login}
          name={p.name}
          size={132}
          round
          eager
          class="h-[132px] w-[132px] shadow-[0_8px_22px_-10px_rgba(23,20,15,0.5)]"
        />
      </span>

      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="labelmono">档案 {idx} / {totalEntries}</span>
          {isPlatform ? (
            <span class="seal">{role?.label}</span>
          ) : (
            <span class="seal">{strategyLabel}</span>
          )}
          {!isPlatform && skills.length >= 12 && (
            <span class="rounded-[2px] border border-[#b23a2b] px-1.5 py-0.5 font-mono text-[10px] text-[#b23a2b]">
              体系型 · {skills.length} skills
            </span>
          )}
          {!isPlatform && skills.length > 0 && skills.length < 12 && (
            <span class="rounded-[2px] border border-slate-800 px-1.5 py-0.5 font-mono text-[10px] text-slate-500">
              {skills.length} skills
            </span>
          )}
          <span class="labelmono">快照 {user.snapshot.date}</span>
        </div>

        <h1 class="mt-2 display text-[2.2rem] leading-none sm:text-[2.9rem]">{p.name}</h1>

        <div class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[12px] text-slate-500">
          <span>@{p.login}</span>
          {p.location && <span>{p.location}</span>}
          {p.joined && <span>{String(p.joined).slice(0, 7)} 加入</span>}
        </div>

        <p class="mt-3 max-w-2xl text-[14.5px] leading-[1.85] text-slate-400">{p.bio}</p>

        <div class="mt-4 flex flex-wrap items-center gap-2">
          {
            links.map((l) => (
              <a
                href={l.href}
                target="_blank"
                rel="noreferrer"
                class="rounded-[2px] border border-slate-800 px-2.5 py-1 font-mono text-[11.5px] text-slate-400 transition-colors hover:border-[#b23a2b] hover:text-[#b23a2b]"
              >
                {l.label} ↗
              </a>
            ))
          }
        </div>
      </div>

      <!-- 关键数字 -->
      <dl class="grid shrink-0 grid-cols-2 gap-x-8 gap-y-4 sm:w-[240px]">
        <div>
          <dt class="labelmono">总星</dt>
          <dd class="font-mono text-[24px] leading-tight">{kfmt(num(s.total_stars_source))}</dd>
        </div>
        <div>
          <dt class="labelmono">中位</dt>
          <dd class="font-mono text-[24px] leading-tight">{num(s.median_stars)}</dd>
        </div>
        <div>
          <dt class="labelmono">{isDepth ? 'top1' : 'top4'} 集中度</dt>
          <dd class="font-mono text-[24px] leading-tight text-[#b23a2b]">
            {isDepth ? `${num(s.top1_share)}%` : `${num(s.top4_share)}%`}
          </dd>
        </div>
        <div>
          <dt class="labelmono">作品</dt>
          <dd class="font-mono text-[24px] leading-tight">{p.source_repos}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 平台方：定的是标准，不是作品 -->
  {
    isPlatform && standards.length > 0 && (
      <section id="standards" class="wrap mt-8">
        <div class="flex items-end justify-between gap-4 border-b border-slate-800 pb-2">
          <h2 class="tick font-display text-[19px] font-semibold">他们定的标准</h2>
          <span class="labelmono">{standards.length} 条</span>
        </div>
        <p class="mt-2 max-w-2xl text-[12.5px] leading-relaxed text-slate-500">
          {role?.desc}。下面每条都是被广泛采用、且能从公开文档里核对的规范——
          它们和个人的方法不同：个人方法是被<strong class="text-slate-300">发现</strong>的，标准是被<strong class="text-slate-300">制定</strong>的。
        </p>

        <div class="mt-4 space-y-2">
          {standards.map((sd, i) => (
            <details class="group/std rounded-[2px] border border-slate-800 bg-[#fbf5e7]/50">
              <summary class="flex cursor-pointer list-none items-start gap-3 px-3.5 py-2.5">
                <span class="mt-0.5 font-mono text-[11px] text-slate-600">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="flex-1 font-display text-[14.5px] font-semibold leading-snug text-slate-100">
                  {sd.name}
                </span>
                <span class="mt-0.5 shrink-0 font-mono text-[10.5px] text-slate-600 transition-transform duration-300 group-open/std:rotate-90">
                  →
                </span>
              </summary>
              <div class="space-y-2.5 border-t border-slate-800 px-3.5 py-3 text-[12.5px] leading-[1.8]">
                <div>
                  <span class="labelmono mr-2">是什么</span>
                  <span class="text-slate-400">{sd.what}</span>
                </div>
                <div>
                  <span class="labelmono mr-2">证据</span>
                  <span class="text-slate-500">{sd.evidence}</span>
                </div>
                <div>
                  <span class="labelmono mr-2">谁在用</span>
                  <span class="text-slate-500">{sd.adopted_by}</span>
                </div>
              </div>
            </details>
          ))}
        </div>
      </section>
    )
  }

  <!-- 分布 + 口径 -->
  <section class="wrap mt-8 grid gap-8 lg:grid-cols-[1.6fr_1fr]">
    <div>
      <h2 class="tick font-display text-[19px] font-semibold">星数分布</h2>
      <p class="mt-1.5 text-[12.5px] leading-relaxed text-slate-500">
        {
          isDepth
            ? '超过一半的仓库不足 10 星——长尾是给核心方法论供血的实验田，不是失败。'
            : '中位数远高于头部占比——大量中等热度的实用小工具构成了资产底盘。'
        }
      </p>

      <div class="mt-4 space-y-2">
        {
          buckets.map((b) => (
            <div class="flex items-center gap-3">
              <span class="w-16 shrink-0 text-right font-mono text-[11px] text-slate-500">{b.label}</span>
              <div class="h-5 flex-1 overflow-hidden rounded-[1px] border border-slate-800 bg-[#f6efdf]">
                <div
                  class:list={['h-full', b.hot ? 'bg-[#b23a2b]' : 'bg-slate-600']}
                  style={`width:${Math.max((b.n / maxBucket) * 100, 3)}%`}
                />
              </div>
              <span class="w-8 shrink-0 font-mono text-[11px] text-slate-400">{b.n}</span>
            </div>
          ))
        }
      </div>

      {
        cats.length > 0 && (
          <>
            <h3 class="tick mt-6 font-display text-[16px] font-semibold">仓库品类</h3>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {cats.map(([c, n]) => (
                <span class="rounded-[2px] border border-slate-800 px-2 py-0.5 text-[11.5px] text-slate-400">
                  {c} <span class="font-mono text-slate-600">{n}</span>
                </span>
              ))}
            </div>
          </>
        )
      }
    </div>

    <aside class="border-t border-slate-800 pt-4 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
      <h2 class="labelmono">数据口径</h2>
      <dl class="mt-3 space-y-2 text-[12.5px]">
        <div class="flex justify-between gap-3">
          <dt class="text-slate-500">总星（自有）</dt>
          <dd class="font-mono text-slate-200">{num(s.total_stars_source).toLocaleString()}</dd>
        </div>
        <div class="flex justify-between gap-3">
          <dt class="text-slate-500">含 fork 合计</dt>
          <dd class="font-mono text-slate-200">{num(s.total_stars_all).toLocaleString()}</dd>
        </div>
        <div class="flex justify-between gap-3">
          <dt class="text-slate-500">无主语言</dt>
          <dd class="font-mono text-slate-200">{num(s.no_language)} / {p.source_repos}</dd>
        </div>
        <div class="flex justify-between gap-3">
          <dt class="text-slate-500">Skills</dt>
          <dd class="font-mono text-slate-200">{user.skills?.count || 0}</dd>
        </div>
        <div class="flex justify-between gap-3">
          <dt class="text-slate-500">Patterns</dt>
          <dd class="font-mono text-slate-200">{patterns.length}</dd>
        </div>
      </dl>

      <p class="mt-4 border-t border-slate-800 pt-3 text-[11.5px] leading-[1.8] text-slate-500">
        {user.snapshot.method}
      </p>
      <p class="mt-2 text-[11.5px] leading-[1.8] text-[#a9722a]">⚠️ {user.snapshot.caveat}</p>
    </aside>
  </section>

  <!-- 作品 -->
  <section id="works" class="wrap mt-12">
    <div class="flex items-end justify-between gap-4 border-b border-slate-800 pb-2">
      <h2 class="tick font-display text-[19px] font-semibold">作品</h2>
      <span class="labelmono">按星数 · 前 {topRepos.length} / 共 {sourceRepos.length}</span>
    </div>

    <ol class="mt-1 divide-y divide-slate-800/60">
      {
        topRepos.map((r, i) => (
          <li class="group flex items-start gap-3 py-2.5 transition-colors hover:bg-[#fbf5e7]/70">
            <span class="mt-1 w-7 shrink-0 font-mono text-[11px] text-slate-600">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-x-2">
                <a
                  href={r.url}
                  target="_blank"
                  rel="noreferrer"
                  class="ulink font-mono text-[13px] font-medium text-slate-100"
                >
                  {r.name}
                </a>
                {(r as any).layer && (
                  <span class="rounded-[2px] border border-slate-800 px-1 font-mono text-[10px] text-slate-500">
                    {(r as any).layer}
                  </span>
                )}
                {r.language && <span class="font-mono text-[10.5px] text-slate-600">{r.language}</span>}
              </div>
              <p class="mt-0.5 line-clamp-1 text-[12px] leading-relaxed text-slate-500">
                {r.description || '—'}
              </p>
            </div>
            <div class="shrink-0 text-right">
              <div class="font-mono text-[12.5px] text-slate-300">★{kfmt(r.stars)}</div>
              <div class="font-mono text-[10px] text-slate-600">
                {(r.updated_at || '').slice(2, 10)}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Skills -->
  {
    skills.length > 0 && (
      <section id="skills" class="wrap mt-12">
        <div class="flex items-end justify-between gap-4 border-b border-slate-800 pb-2">
          <h2 class="tick font-display text-[19px] font-semibold">收录的 Skills</h2>
          <span class="labelmono">{skills.length} 条</span>
        </div>
        <div class="mt-3 grid gap-2 sm:grid-cols-2">
          {skills.slice(0, 24).map((sk) => (
            <div class="rounded-[2px] border border-slate-800 bg-[#fbf5e7]/50 px-3 py-2">
              <div class="flex items-baseline justify-between gap-2">
                <span class="truncate font-mono text-[12px] text-slate-200">{sk.name}</span>
                <span class="shrink-0 font-mono text-[10px] text-slate-600">{sk.layer || sk.category}</span>
              </div>
              {sk.summary && (
                <p class="mt-1 line-clamp-2 text-[11.5px] leading-snug text-slate-500">{sk.summary}</p>
              )}
            </div>
          ))}
        </div>
        {skills.length > 24 && (
          <p class="mt-2 font-mono text-[11px] text-slate-600">另有 {skills.length - 24} 条未展开</p>
        )}
      </section>
    )
  }

  <!-- Patterns -->
  {
    patterns.length > 0 && (
      <section id="methods" class="wrap mt-12">
        <div class="flex items-end justify-between gap-4 border-b border-slate-800 pb-2">
          <h2 class="tick font-display text-[19px] font-semibold">提炼出的方法</h2>
          <span class="labelmono">{patterns.length} 条</span>
        </div>
        <ul class="mt-3 space-y-2">
          {patterns.slice(0, 12).map((pt) => (
            <li class="text-[13px] leading-relaxed">
              <span class="mr-2 font-mono text-[10.5px] text-slate-600">{pt.id}</span>
              <span class="text-slate-200">{pt.name}</span>
              {pt.claim && <span class="text-slate-500"> — {pt.claim}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- 五问拆解（折叠） -->
  {
    analyses.length > 0 && (
      <section id="dive" class="wrap mt-12">
        <div class="flex items-end justify-between gap-4 border-b border-slate-800 pb-2">
          <h2 class="tick font-display text-[19px] font-semibold">深度拆解</h2>
          <span class="labelmono">{analyses.length} 个 skill · 五问</span>
        </div>
        <div class="mt-3 space-y-2">
          {analyses.map((a) => (
            <details class="group rounded-[2px] border border-slate-800 bg-[#fbf5e7]/50 px-3 py-2">
              <summary class="flex cursor-pointer list-none items-baseline justify-between gap-3">
                <span class="font-mono text-[12.5px] text-slate-200">
                  {a.name}
                  <span class="ml-2 text-[10.5px] text-slate-600">{a.repo}</span>
                </span>
                <span class="shrink-0 font-mono text-[10.5px] text-slate-600">
                  ★{kfmt(num(a.stars))} · 展开
                </span>
              </summary>
              <div class="mt-2.5 space-y-2.5 border-t border-slate-800 pt-2.5 text-[12.5px] leading-[1.8]">
                <p><span class="labelmono mr-2">结论</span>{a.verdict}</p>
                <p><span class="labelmono mr-2">解决</span>{a.problem}</p>
                {a.mechanism?.length > 0 && (
                  <div>
                    <span class="labelmono">机制</span>
                    <ul class="mt-1 space-y-1 text-slate-400">
                      {a.mechanism.map((m) => (
                        <li class="flex gap-2"><span class="text-[#b23a2b]">·</span><span>{m}</span></li>
                      ))}
                    </ul>
                  </div>
                )}
                {a.takeaway?.length > 0 && (
                  <div>
                    <span class="labelmono">能搬走什么</span>
                    <ul class="mt-1 space-y-1 text-slate-400">
                      {a.takeaway.map((m) => (
                        <li class="flex gap-2"><span class="text-[#b23a2b]">·</span><span>{m}</span></li>
                      ))}
                    </ul>
                  </div>
                )}
                {a.limits?.length > 0 && (
                  <div>
                    <span class="labelmono">局限</span>
                    <ul class="mt-1 space-y-1 text-slate-500">
                      {a.limits.map((m) => (
                        <li class="flex gap-2"><span class="text-slate-600">·</span><span>{m}</span></li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </details>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
