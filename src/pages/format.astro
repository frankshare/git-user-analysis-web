---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

const file = path.resolve('src/data/format-adoption.json');
const data = fs.existsSync(file) ? JSON.parse(fs.readFileSync(file, 'utf-8')) : null;

// 写法趋同（第三类发现）：description 内部结构
const styleFile = path.resolve('src/data/desc-style.json');
const style = fs.existsSync(styleFile) ? JSON.parse(fs.readFileSync(styleFile, 'utf-8')) : null;
const pct = (a: number, b: number) => (b ? Math.round((a / b) * 100) : 0);

const verified = data?.verified || [];
const canonical = verified.filter((v: any) => v.canonical);
const extended = verified.filter((v: any) => v.extended);
const fieldCount: Record<string, number> = {};
for (const v of verified) {
  for (const f of v.fields) fieldCount[f] = (fieldCount[f] || 0) + 1;
}
const fieldRank = Object.entries(fieldCount).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="格式采用率研究 · Git 用户分析" description="SKILL.md 的 name+description 双字段是否已成为跨语言的事实标准" active="research">
  <section class="wrap pt-10 sm:pt-14">
    <div class="border-b border-slate-800 pb-8">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <span class="seal">附录 · 格式</span>
        <span class="labelmono">严格验证 · 直接抓真实 SKILL.md 解析 frontmatter</span>
      </div>
      <h1 class="display text-[2.2rem] sm:text-[3.1rem]">
        <span class="line-up"><span>格式趋同：平台推动的收敛</span></span>
      </h1>
      <p class="mt-4 max-w-2xl text-[14.5px] leading-[1.85] text-slate-400">
        这是本站发现的<strong class="text-slate-200">第一类由平台推动的收敛</strong>。C1–C7 是创作者<strong>独立发现</strong>的共同方法；这一类不同——它是被标准制定者<strong>设计出来</strong>，然后被采用。
      </p>
    </div>
  </section>


  {data && (
    <div class="wrap">
      <!-- 核心结论 -->
      <section class="bg-sky-500/5 border border-sky-500/20 rounded-[3px] p-6 sm:p-8 mb-10">
        <h2 class="text-lg font-bold text-white mb-3">核心结论</h2>
        <p class="text-slate-300 leading-relaxed mb-4">
          <strong class="text-sky-300">SKILL.md 的 <code class="font-mono text-sm">name</code> + <code class="font-mono text-sm">description</code> 双字段，已成为跨语言、跨平台的实际事实标准。</strong>
        </p>
        <p class="text-sm text-slate-400 leading-relaxed">
          {verified.length} 个已验证的 skill 仓<strong class="text-slate-200">全部</strong>使用这个双字段格式——
          中文圈（花叔、归藏、obra、李继刚、姚金刚）与英文圈（addyosmani、sickn33）用<strong>完全相同的字段名</strong>。
          而这 11 个样本里，只有 1 个是平台官方（anthropics 自己）——<strong class="text-slate-200">其余 10 个全是个人创作者</strong>。
        </p>
      </section>

      <!-- 统计 -->
      <section class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
        <div class="bg-slate-900/60 border border-slate-800 rounded-[2px] p-4 sm:p-5">
          <div class="text-xs text-slate-400 font-medium">已验证 skill 仓</div>
          <div class="text-2xl sm:text-3xl font-bold text-white mt-1 font-mono">{verified.length}</div>
          <div class="text-xs text-slate-500 mt-1">直接读 SKILL.md</div>
        </div>
        <div class="bg-slate-900/60 border border-slate-800 rounded-[2px] p-4 sm:p-5">
          <div class="text-xs text-slate-400 font-medium">canonical 格式</div>
          <div class="text-2xl sm:text-3xl font-bold text-sky-400 mt-1 font-mono">{canonical.length}</div>
          <div class="text-xs text-slate-500 mt-1">含 name + description</div>
        </div>
        <div class="bg-slate-900/60 border border-slate-800 rounded-[2px] p-4 sm:p-5">
          <div class="text-xs text-slate-400 font-medium">扩展用法</div>
          <div class="text-2xl sm:text-3xl font-bold text-amber-400 mt-1 font-mono">{extended.length}</div>
          <div class="text-xs text-slate-500 mt-1">在标准上加自有元数据</div>
        </div>
        <div class="bg-slate-900/60 border border-slate-800 rounded-[2px] p-4 sm:p-5">
          <div class="text-xs text-slate-400 font-medium">第三字段</div>
          <div class="text-2xl sm:text-3xl font-bold text-emerald-400 mt-1 font-mono">
            {fieldCount['metadata'] || 0}
          </div>
          <div class="text-xs text-slate-500 mt-1">metadata 最常见</div>
        </div>
      </section>

      <!-- 字段排名 -->
      <section class="bg-slate-900/60 border border-slate-800 rounded-[3px] p-6 sm:p-8 mb-10">
        <h2 class="text-base font-bold text-white mb-1">字段使用排名</h2>
        <p class="text-xs text-slate-500 mb-5">
          分母为 {verified.length} 个已验证仓。注意 <code class="font-mono">name</code> 与 <code class="font-mono">description</code> 是压倒性的，
          而 <code class="font-mono">allowed-tools</code> 与 <code class="font-mono">license</code> 各只有 1 例——<strong>工具限制与许可并非事实标准</strong>。
        </p>
        <div class="space-y-2.5">
          {fieldRank.map(([f, c]) => (
            <div class="flex items-center gap-3">
              <div class="w-36 text-xs font-mono text-slate-300 shrink-0">{f}</div>
              <div class="flex-1 h-6 bg-slate-950/60 rounded-md overflow-hidden border border-slate-800/50">
                <div
                  class="h-full bg-gradient-to-r from-sky-500 to-indigo-500 flex items-center justify-end pr-2 text-[11px] font-mono font-bold text-white"
                  style={`width: ${Math.max((c / verified.length) * 100, 6)}%`}
                >
                  {c}
                </div>
              </div>
              <div class="w-12 text-xs text-slate-500 font-mono shrink-0 text-right">
                {Math.round((c / verified.length) * 100)}%
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 逐仓明细 -->
      <section class="mb-10">
        <h2 class="text-base font-bold text-white mb-4">逐仓验证明细</h2>
        <div class="overflow-x-auto rounded-[3px] border border-slate-800">
          <table class="w-full text-sm">
            <thead class="bg-slate-900/80 text-slate-400 text-xs uppercase tracking-wider">
              <tr>
                <th class="text-left font-medium px-4 py-3">创作者</th>
                <th class="text-left font-medium px-4 py-3">仓库</th>
                <th class="text-left font-medium px-4 py-3">SKILL.md 路径</th>
                <th class="text-left font-medium px-4 py-3">frontmatter 字段</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60">
              {verified.map((v: any) => (
                <tr class="hover:bg-slate-900/40 transition-colors">
                  <td class="px-4 py-3">
                    <span class="text-slate-200">{v.user}</span>
                    {v.canonical && (
                      <span class="ml-1.5 px-1.5 py-0.5 rounded bg-sky-500/10 text-sky-400 text-[10px]">canonical</span>
                    )}
                    {v.extended && (
                      <span class="ml-1.5 px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-400 text-[10px]">扩展</span>
                    )}
                  </td>
                  <td class="px-4 py-3">
                    <a href={`https://github.com/${v.user}/${v.repo}`} target="_blank" rel="noreferrer" class="font-mono text-xs text-indigo-400 hover:text-indigo-300">
                      {v.repo}
                    </a>
                  </td>
                  <td class="px-4 py-3 font-mono text-xs text-slate-500">{v.path}</td>
                  <td class="px-4 py-3">
                    <div class="flex flex-wrap gap-1.5">
                      {v.fields.map((f: string) => (
                        <span class={`px-1.5 py-0.5 rounded font-mono text-[10px] ${
                          f === 'name' || f === 'description'
                            ? 'bg-sky-500/15 text-sky-300 border border-sky-500/25'
                            : 'bg-slate-800 text-slate-400 border border-slate-700/50'
                        }`}>
                          {f}
                        </span>
                      ))}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {/* 未使用 SKILL.md 的 */}
      <section class="bg-slate-900/40 border border-slate-800/60 rounded-[3px] p-6 sm:p-8 mb-10">
        <h2 class="text-base font-bold text-white mb-1">走的是另一条路线的资产</h2>
        <p class="text-xs text-slate-500 mb-4">
          不是所有 skill 资产都用 SKILL.md。这几家用的是<strong class="text-slate-300">插件 / 扩展点</strong>路线——
          它们的「标准」不是文件格式，而是协议。
        </p>
        <div class="space-y-2">
          {(data.not_found || []).map((n: any) => (
            <div class="flex items-start gap-3 text-sm">
              <span class="font-mono text-xs text-slate-600 pt-0.5 shrink-0">{n.user}/{n.repo}</span>
              <span class="text-slate-400">{n.reason}</span>
            </div>
          ))}
        </div>
      </section>

      {/* 解读与边界 */}
      <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-slate-900/40 border border-slate-800/60 rounded-[3px] p-6">
          <h2 class="text-base font-bold text-white mb-3">为什么这条发现重要</h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            C1–C7 讲的是「怎么做才可靠」，是创作者在实践中撞出来的。
            这一条讲的是「怎么让别人找到你」——它有直接的操作价值：
            <strong class="text-slate-200">想被生态发现，就用这个格式。</strong>
          </p>
          <p class="text-sm text-slate-400 leading-relaxed mt-3">
            还有一个更深的含义：<strong class="text-slate-200">格式趋同让方法可以跨平台迁移。</strong>
            一个遵循 `name`+`description` 的 skill，能被 Claude Code、Codex、Cursor 等多个 harness 加载——
            这正是 obra 做 `everyharness`（一份清单生成 11 种 harness）的物理基础。
          </p>
        </div>

        <div class="bg-slate-900/40 border border-slate-800/60 rounded-[3px] p-6">
          <h2 class="text-base font-bold text-white mb-3">边界（对自己诚实）</h2>
          <ul class="space-y-2 text-sm text-slate-400">
            {(data.interpretation?.caveats || []).map((c: string) => (
              <li class="flex gap-2">
                <span class="text-amber-500 shrink-0">·</span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* 方法说明 */}
      <section class="mt-10 bg-slate-900/40 border border-slate-800/60 rounded-[3px] p-6 sm:p-8">
        <h2 class="text-base font-bold text-white mb-3">验证方法</h2>
        <p class="text-sm text-slate-400 leading-relaxed mb-3">{data.methodology}</p>
        <p class="text-xs text-slate-500 leading-relaxed">
          注：这条研究是对 {verified.length} 个代表性 skill 仓的严格抽查（来自 29 位创作者中的 8 位），
          不是全量普查。全量普查需要逐个 skill 目录展开，成本高但可以后续补。
        </p>
      </section>
    </>
  )}

      {/* ===== 第三类发现：写法趋同 ===== */}
      {style && (
        <section class="mt-14 pt-10 border-t border-slate-800">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-[2px] bg-violet-500/10 border border-violet-500/20 text-violet-300 text-xs font-medium mb-4">
            <span>第三类发现 · 字段之内的写法</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-4">
            写法趋同：<code class="font-mono text-xl">description</code> 已经变成「触发条件清单」
          </h2>
          <p class="text-slate-400 leading-relaxed max-w-3xl mb-8">
            上一节证明的是<strong class="text-slate-200">字段</strong>趋同。这一节往下再挖一层：
            字段里面的字<strong class="text-slate-200">怎么写</strong>，是否也趋同？
            官方规范只说「写个 description」，没说怎么写——但 {style.sample.skill_md} 个真实 SKILL.md
            （{style.sample.repos_with_skill_md} 个仓、{style.by_author.length} 位创作者）里，
            绝大多数人<strong class="text-violet-300">自发写成了同一种两段式</strong>。
          </p>

          <div class="bg-violet-500/5 border border-violet-500/20 rounded-[3px] p-6 sm:p-8 mb-8">
            <p class="text-sm text-slate-400 mb-3">主流结构（不是句首 Use when，而是「先陈述、后触发」）</p>
            <pre class="font-mono text-xs sm:text-sm text-violet-200 bg-slate-950/60 rounded-[2px] p-4 overflow-x-auto whitespace-pre-wrap">能力陈述句。Use when 场景A。Use when 场景B。
能力陈述。…… 当用户提到「短语1」「短语2」时使用。</pre>
            <p class="text-xs text-slate-500 mt-3 leading-relaxed">
              这不是平台规定的，是社区自己长出来的写法惯例——<strong class="text-slate-300">格式给了空位，社区把空位填成了同一个形状。</strong>
            </p>
          </div>

          <section class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
            <div class="bg-slate-900/60 border border-slate-800 rounded-[2px] p-4 sm:p-5">
              <div class="text-xs text-slate-400 font-medium">采集 SKILL.md</div>
              <div class="text-2xl sm:text-3xl font-bold text-white mt-1 font-mono">{style.sample.skill_md}</div>
              <div class="text-xs text-slate-500 mt-1">{style.sample.repos_with_skill_md} 仓 · 上限 6/仓</div>
            </div>
            <div class="bg-slate-900/60 border border-slate-800 rounded-[2px] p-4 sm:p-5">
              <div class="text-xs text-slate-400 font-medium">英文含触发句</div>
              <div class="text-2xl sm:text-3xl font-bold text-violet-400 mt-1 font-mono">{pct(style.en.with_trigger, style.sample.en)}%</div>
              <div class="text-xs text-slate-500 mt-1">{style.en.with_trigger}/{style.sample.en} 条</div>
            </div>
            <div class="bg-slate-900/60 border border-slate-800 rounded-[2px] p-4 sm:p-5">
              <div class="text-xs text-slate-400 font-medium">中文含触发表述</div>
              <div class="text-2xl sm:text-3xl font-bold text-violet-400 mt-1 font-mono">{pct(style.zh.with_trigger, style.sample.zh)}%</div>
              <div class="text-xs text-slate-500 mt-1">{style.zh.with_trigger}/{style.sample.zh} 条</div>
            </div>
            <div class="bg-slate-900/60 border border-slate-800 rounded-[2px] p-4 sm:p-5">
              <div class="text-xs text-slate-400 font-medium">description 中位数</div>
              <div class="text-2xl sm:text-3xl font-bold text-white mt-1 font-mono">{style.length.median}</div>
              <div class="text-xs text-slate-500 mt-1">字符 · 34% 超 320</div>
            </div>
          </section>

          <section class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="bg-slate-900/40 border border-slate-800/60 rounded-[3px] p-6">
              <h3 class="text-base font-bold text-white mb-4">中英两圈，同一结构，不同标记</h3>
              <table class="w-full text-sm">
                <thead>
                  <tr class="text-xs text-slate-500 border-b border-slate-800">
                    <th class="text-left py-2 font-medium">特征</th>
                    <th class="text-right py-2 font-medium">英文</th>
                    <th class="text-right py-2 font-medium">中文</th>
                  </tr>
                </thead>
                <tbody class="text-slate-300">
                  <tr class="border-b border-slate-800/60">
                    <td class="py-2">两段式（能力 + 触发）</td>
                    <td class="py-2 text-right font-mono text-violet-300">{pct(style.en.two_part, style.sample.en)}%</td>
                    <td class="py-2 text-right font-mono text-violet-300">{pct(style.zh.two_part, style.sample.zh)}%</td>
                  </tr>
                  <tr class="border-b border-slate-800/60">
                    <td class="py-2">触发句放句首</td>
                    <td class="py-2 text-right font-mono">{pct(style.en.trigger_first, style.sample.en)}%</td>
                    <td class="py-2 text-right font-mono">{pct(style.zh.trigger_first, style.sample.zh)}%</td>
                  </tr>
                  <tr class="border-b border-slate-800/60">
                    <td class="py-2">完全没有触发表述</td>
                    <td class="py-2 text-right font-mono">{pct(style.en.no_when_clause, style.sample.en)}%</td>
                    <td class="py-2 text-right font-mono">{pct(style.zh.no_trigger_words, style.sample.zh)}%</td>
                  </tr>
                  <tr>
                    <td class="py-2">用「」列举触发短语</td>
                    <td class="py-2 text-right font-mono text-slate-500">—</td>
                    <td class="py-2 text-right font-mono text-violet-300">{pct(style.zh.corner_bracket_list, style.sample.zh)}%</td>
                  </tr>
                </tbody>
              </table>
              <p class="text-xs text-slate-500 mt-4 leading-relaxed">
                中文圈几乎不把触发句放句首（{style.zh.trigger_first}/{style.sample.zh}），
                而是先讲清能干什么，最后一句列「」。{pct(style.zh.corner_bracket_list, style.sample.zh)}% 用「」当检索标记——这是中文圈独有的。
              </p>
            </div>

            <div class="bg-slate-900/40 border border-slate-800/60 rounded-[3px] p-6">
              <h3 class="text-base font-bold text-white mb-4">跨作者：{style.by_author.filter((a) => a.rate >= 50).length} 位过半使用</h3>
              <div class="space-y-1.5 max-h-80 overflow-y-auto pr-1">
                {style.by_author.map((a: any) => (
                  <div class="flex items-center gap-2 text-xs">
                    <span class="w-28 shrink-0 text-slate-400 font-mono truncate">{a.login}</span>
                    <div class="flex-1 h-1.5 bg-slate-800 rounded-[2px] overflow-hidden">
                      <div class={`h-full rounded-[2px] ${a.rate >= 80 ? 'bg-violet-400' : a.rate >= 50 ? 'bg-violet-500/70' : a.rate > 0 ? 'bg-slate-500' : 'bg-rose-500/60'}`} style={`width:${Math.max(a.rate, 2)}%`}></div>
                    </div>
                    <span class="w-12 text-right font-mono text-slate-400">{a.rate}%</span>
                    <span class="w-10 text-right font-mono text-slate-600">{a.with_trigger}/{a.samples}</span>
                  </div>
                ))}
              </div>
              <p class="text-xs text-slate-500 mt-4 leading-relaxed">
                <strong class="text-slate-300">反例同样重要</strong>：sickn33、steipete、yanhua1010 是 0%——
                说明这不是强制。但没有一位是靠「写得更有文采」取胜。
              </p>
            </div>
          </section>

          <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-slate-900/40 border border-slate-800/60 rounded-[3px] p-6">
              <h3 class="text-base font-bold text-white mb-3">可以立刻用的模板</h3>
              <pre class="font-mono text-xs text-slate-300 bg-slate-950/60 rounded-[2px] p-4 overflow-x-auto whitespace-pre-wrap">能力陈述（动词开头）。产出/差异。
Use when 场景1、场景2、场景3，
或用户说 "口语说法1"、"口语说法2"。</pre>
              <ul class="space-y-2 text-sm text-slate-400 mt-4">
                <li class="flex gap-2"><span class="text-violet-400 shrink-0">1</span><span>必须有能力陈述，不能只有触发词</span></li>
                <li class="flex gap-2"><span class="text-violet-400 shrink-0">2</span><span>触发条件要具体到用户的原话</span></li>
                <li class="flex gap-2"><span class="text-violet-400 shrink-0">3</span><span>200–300 字符是甜区</span></li>
              </ul>
            </div>
            <div class="bg-slate-900/40 border border-slate-800/60 rounded-[3px] p-6">
              <h3 class="text-base font-bold text-white mb-3">三类发现的区别</h3>
              <ul class="space-y-3 text-sm text-slate-400">
                <li><strong class="text-slate-200">C1–C7 收敛簇</strong> —— 方法机制，互不相识的人独立撞上同一堵墙</li>
                <li><strong class="text-slate-200">格式趋同</strong> —— 平台定标准、创作者采用，<em class="text-slate-500">被设计出来的</em></li>
                <li><strong class="text-violet-300">写法趋同</strong> —— 格式给了空位，社区把空位填成同一个形状，<em class="text-slate-500">自发涌现的惯例</em></li>
              </ul>
              <div class="mt-4 pt-4 border-t border-slate-800/60">
                <p class="text-xs text-slate-500 mb-2">边界</p>
                <ul class="space-y-1.5 text-xs text-slate-500">
                  {(style.interpretation?.caveats || []).map((c: string) => (
                    <li class="flex gap-2"><span class="text-amber-500 shrink-0">·</span><span>{c}</span></li>
                  ))}
                </ul>
              </div>
            </div>
          </section>

          <p class="text-xs text-slate-500 mt-6 leading-relaxed">
