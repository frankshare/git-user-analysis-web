---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllOrgs, ROLE_LABELS } from '../lib/orgs';

const orgs = getAllOrgs();
const totalStars = orgs.reduce((a, o) => a + o.stats.total_stars_source, 0);
const totalRepos = orgs.reduce((a, o) => a + o.profile.source_repos, 0);
const totalStandards = orgs.reduce((a, o) => a + o.standards.length, 0);
---

<BaseLayout title="平台方供给 · 星册" description="组织型（平台方）skill 资产：它们定义标准，而不是表达个人" active="research">
  <section class="wrap pt-10 sm:pt-14">
    <div class="border-b border-slate-800 pb-8">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <span class="seal">附录 · 平台方</span>
        <span class="labelmono">与个人创作者物理分开 · 不参与收敛判定</span>
      </div>
      <h1 class="display text-[2.2rem] sm:text-[3.1rem]">
        <span class="line-up"><span>平台方供给</span></span>
      </h1>
      <p class="mt-4 max-w-2xl text-[14.5px] leading-[1.85] text-slate-400">
        前面 29 位是<strong class="text-slate-200">个人创作者</strong>——他们在表达自己的方法。这里是<strong class="text-slate-200">组织与平台</strong>——他们在<strong class="text-slate-200">定义标准</strong>。
      </p>
      <div class="mt-5 rounded-[2px] border border-amber-500/25 bg-amber-500/5 px-4 py-3">
        <p class="text-[13px] leading-[1.8] text-amber-400/90">
          <strong>为什么必须分开：</strong>收敛簇的判据是「同一方法在 ≥3 位<strong>互不相识</strong>的创作者、不同领域独立出现」。
          平台的官方 skill 不是独立出现的——它是被<strong>设计成标准</strong>的。
          把 anthropics 的 <code class="font-mono text-xs">skills</code> 算进「单一事实源」这一簇，
          等于把「标准制定者」和「采用者」混为一谈。所以这里的所有 pattern 都标了
          <code class="font-mono text-xs">counted_in_convergence: false</code>。
        </p>
      </div>
    </div>
  </section>


  <section class="wrap grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
    <div class="bg-slate-900/60 border border-slate-800 rounded-[2px] p-4 sm:p-5">
      <div class="text-xs text-slate-400 font-medium">收录组织</div>
      <div class="text-2xl sm:text-3xl font-bold text-white mt-1 font-mono">{orgs.length}</div>
      <div class="text-xs text-slate-500 mt-1">运行时 / 标准 / 社区</div>
    </div>
    <div class="bg-slate-900/60 border border-slate-800 rounded-[2px] p-4 sm:p-5">
      <div class="text-xs text-slate-400 font-medium">自有仓库</div>
      <div class="text-2xl sm:text-3xl font-bold text-amber-400 mt-1 font-mono">{totalRepos}</div>
      <div class="text-xs text-slate-500 mt-1">不含 fork</div>
    </div>
    <div class="bg-slate-900/60 border border-slate-800 rounded-[2px] p-4 sm:p-5">
      <div class="text-xs text-slate-400 font-medium">总 star</div>
      <div class="text-2xl sm:text-3xl font-bold text-white mt-1 font-mono">{totalStars.toLocaleString()}</div>
      <div class="text-xs text-slate-500 mt-1">组织整体，非单个 skill</div>
    </div>
    <div class="bg-slate-900/60 border border-slate-800 rounded-[2px] p-4 sm:p-5">
      <div class="text-xs text-slate-400 font-medium">定义的标准</div>
      <div class="text-2xl sm:text-3xl font-bold text-emerald-400 mt-1 font-mono">{totalStandards}</div>
      <div class="text-xs text-slate-500 mt-1">格式 / 协议 / 分发</div>
    </div>
  </section>

  <section class="wrap space-y-8">
    {orgs.map(org => {
      const role = ROLE_LABELS[org.profile.platform_role] || ROLE_LABELS.community_hub;
      const topRepos = [...org.repos].filter(r => !r.fork).sort((a, b) => b.stars - a.stars).slice(0, 8);
      const topAnalyses = [...org.skill_analyses].sort((a, b) => b.stars - a.stars);

      return (
        <div class="bg-slate-900/60 border border-slate-800 rounded-[3px] overflow-hidden">
          {/* 头部 */}
          <div class="p-6 border-b border-slate-800/70">
            <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-5">
              <div class="flex-1">
                <div class="flex items-center gap-2.5 flex-wrap mb-3">
                  <h2 class="text-xl font-bold text-white">{org.profile.name}</h2>
                  <span class="font-mono text-sm text-slate-500">@{org.profile.login}</span>
                  <span class="px-2.5 py-0.5 rounded-[2px] text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
                    {role.label}
                  </span>
                  <span class="px-2.5 py-0.5 rounded-[2px] text-xs font-medium bg-slate-700/40 text-slate-400 border border-slate-600/40">
                    平台方供给
                  </span>
                </div>
                <p class="text-sm text-slate-300 leading-relaxed max-w-3xl">{org.profile.bio}</p>
                <p class="text-xs text-slate-500 mt-2">{role.desc}</p>
              </div>

              <div class="grid grid-cols-3 gap-3 lg:w-[300px] shrink-0">
                <div class="bg-slate-950/40 p-3 rounded-[2px] border border-slate-800/60 text-center">
                  <div class="text-xs text-slate-400">总星</div>
                  <div class="text-base font-bold text-white font-mono mt-0.5">{org.stats.total_stars_source.toLocaleString()}</div>
                </div>
                <div class="bg-slate-950/40 p-3 rounded-[2px] border border-slate-800/60 text-center">
                  <div class="text-xs text-slate-400">源仓</div>
                  <div class="text-base font-bold text-white font-mono mt-0.5">{org.profile.source_repos}</div>
                </div>
                <div class="bg-slate-950/40 p-3 rounded-[2px] border border-slate-800/60 text-center">
                  <div class="text-xs text-slate-400">中位数</div>
                  <div class="text-base font-bold text-amber-400 font-mono mt-0.5">{org.stats.median_stars}</div>
                </div>
              </div>
            </div>
          </div>

          {/* 定义的标准 */}
          {org.standards.length > 0 && (
            <div class="p-6 border-b border-slate-800/70">
              <h3 class="text-sm font-bold text-white mb-1">它定义了什么标准</h3>
              <p class="text-xs text-slate-500 mb-4">
                这是平台型资产的核心价值——不是「有多少 skill」，而是「多少人在按它的格式干活」。
              </p>
              <div class="space-y-2.5">
                {org.standards.map(s => (
                  <div class="bg-slate-950/40 border border-slate-800/60 rounded-[2px] p-4">
                    <div class="flex items-start gap-3 mb-1.5">
                      <span class="font-mono text-xs text-emerald-500/70 pt-0.5 shrink-0">▪</span>
                      <div class="flex-1 min-w-0">
                        <h4 class="text-sm font-bold text-slate-100">{s.name}</h4>
                        <p class="text-xs text-slate-400 mt-1 leading-relaxed">{s.what}</p>
                        <div class="mt-2 flex items-start gap-2 flex-wrap">
                          <span class="text-[10px] text-slate-600 shrink-0 pt-0.5">证据</span>
                          <span class="text-[11px] text-slate-500">{s.evidence}</span>
                        </div>
                        <div class="mt-1 flex items-start gap-2 flex-wrap">
                          <span class="text-[10px] text-slate-600 shrink-0 pt-0.5">采用方</span>
                          <span class="text-[11px] text-slate-500">{s.adopted_by}</span>
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* 关键仓 */}
          <div class="p-6 border-b border-slate-800/70">
            <h3 class="text-sm font-bold text-white mb-3">关键仓库（{topAnalyses.length} 个已拆解）</h3>
            <div class="space-y-3">
              {topAnalyses.map(a => (
                <details class="bg-slate-950/30 border border-slate-800/60 rounded-[2px]">
                  <summary class="cursor-pointer list-none p-4 flex items-center justify-between gap-3">
                    <div class="min-w-0">
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-mono text-sm text-indigo-400">{a.name}</span>
                        <span class="text-xs text-slate-500 truncate">{a.verdict}</span>
                      </div>
                    </div>
                    <span class="text-xs font-mono text-amber-400 shrink-0">{a.stars.toLocaleString()} ★</span>
                  </summary>
                  <div class="px-4 pb-4 pt-1 border-t border-slate-800/50 space-y-3">
                    <div>
                      <div class="text-[11px] font-bold text-indigo-400 mb-1">解决什么</div>
                      <p class="text-xs text-slate-300 leading-relaxed">{a.problem}</p>
                    </div>
                    <div>
                      <div class="text-[11px] font-bold text-emerald-400 mb-1">核心机制</div>
                      <ul class="space-y-1">
                        {a.mechanism.map(m => (
                          <li class="text-xs text-slate-300 leading-relaxed flex gap-2">
                            <span class="text-emerald-500/60 shrink-0">▸</span><span>{m}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                      <div>
                        <div class="text-[11px] font-bold text-amber-400 mb-1">工程约束</div>
                        <ul class="space-y-1">
                          {a.constraints.map(c => (
                            <li class="text-xs text-slate-400 leading-relaxed flex gap-2">
                              <span class="text-amber-500/60 shrink-0">▸</span><span>{c}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <div>
                        <div class="text-[11px] font-bold text-sky-400 mb-1">能搬走什么</div>
                        <ul class="space-y-1">
                          {a.takeaway.map(t => (
                            <li class="text-xs text-slate-300 leading-relaxed flex gap-2">
                              <span class="text-sky-500/60 shrink-0">▸</span><span>{t}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <div>
                        <div class="text-[11px] font-bold text-rose-400 mb-1">局限</div>
                        <ul class="space-y-1">
                          {a.limits.map(l => (
                            <li class="text-xs text-slate-400 leading-relaxed flex gap-2">
                              <span class="text-rose-500/60 shrink-0">▸</span><span>{l}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>

          {/* 仓库表 */}
          <div class="p-6">
            <h3 class="text-sm font-bold text-white mb-3">Top 8 仓库</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="text-slate-400 text-xs uppercase tracking-wider">
                  <tr>
                    <th class="text-left font-medium py-2 w-10">#</th>
                    <th class="text-left font-medium py-2">仓库</th>
                    <th class="text-left font-medium py-2 w-28">语言</th>
                    <th class="text-right font-medium py-2 w-24">Star</th>
                    <th class="text-left font-medium py-2 w-32">分类</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60">
                  {topRepos.map((r, i) => (
                    <tr class="hover:bg-slate-900/40 transition-colors">
                      <td class="py-2.5 text-slate-600 font-mono text-xs">{i + 1}</td>
                      <td class="py-2.5">
                        <a href={r.url} target="_blank" rel="noreferrer" class="text-indigo-400 hover:text-indigo-300 transition-colors font-mono text-xs">
                          {r.name}
                        </a>
                        {r.description && (
                          <div class="text-[11px] text-slate-500 mt-0.5 truncate max-w-xl">{r.description}</div>
                        )}
                      </td>
                      <td class="py-2.5 text-slate-400 text-xs font-mono">{r.language || '—'}</td>
                      <td class="py-2.5 text-right font-mono text-slate-200 text-xs">{r.stars.toLocaleString()}</td>
                      <td class="py-2.5 text-xs text-slate-400">{r.category}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      );
    })}
  </section>

  <section class="wrap mt-10 bg-slate-900/40 border border-slate-800/60 rounded-[3px] p-6 sm:p-8">
    <h2 class="text-lg font-bold text-white mb-3">收录标准与边界</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
      <div>
        <h3 class="text-sm font-bold text-emerald-400 mb-2">满足以下全部条件才收录</h3>
        <ul class="space-y-1.5 text-slate-400">
          <li class="flex gap-2"><span class="text-emerald-500 shrink-0">·</span>官方维护，不是个人 fork 集合</li>
          <li class="flex gap-2"><span class="text-emerald-500 shrink-0">·</span>有明确的 skill / plugin 目录或规范</li>
          <li class="flex gap-2"><span class="text-emerald-500 shrink-0">·</span>能说明它定义了什么标准，而不只是堆了一批提示词</li>
        </ul>
        <p class="text-xs text-slate-500 mt-3 leading-relaxed">
          不满足的（microsoft 952 个源仓、huggingface 396 个）**不收录**——它们是代码组织，不是 skill 组织。
          收录会污染统计。
        </p>
      </div>
      <div>
        <h3 class="text-sm font-bold text-amber-400 mb-2">抓取方式必须不同</h3>
        <p class="text-slate-400 leading-relaxed text-xs">
          组织页与个人页 HTML 结构不同（组织页是 pinned 网格、星数是 <code class="font-mono">183k</code> 缩写、字段在兄弟节点上），
          按标记切块会错位——本轮实际踩过：所有仓库被解析成同一个。
          <strong class="text-slate-300">组织仓一律走认证 REST API</strong>，代价是需要 token（匿名 60 次/小时，共享 IP 极易限流）。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
