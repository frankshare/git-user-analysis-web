---
interface Props {
  no: string;
  stars: string;
}
const { no, stars } = Astro.props;
---

<span
  class="absolute left-2 top-2 rounded-[2px] bg-[#17140f]/78 px-1.5 py-0.5 font-mono text-[12px] text-[#f6efdf]"
>
  {no}
</span>
<span
  class="absolute right-2 top-2 rounded-[2px] bg-[#f6efdf]/90 px-1.5 py-0.5 font-mono text-[12px] text-[#17140f]"
>
  ★{stars}
</span>
