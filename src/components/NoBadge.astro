---
interface Props {
  no: string;
  stars: string;
}
const { no, stars } = Astro.props;
---

<span
  class="absolute left-2 top-2 rounded-[2px] bg-[var(--color-white)]/78 px-1.5 py-0.5 font-mono text-[12px] text-[var(--color-slate-900)]"
>
  {no}
</span>
<span
  class="absolute right-2 top-2 rounded-[2px] bg-[var(--color-slate-950)]/90 px-1.5 py-0.5 font-mono text-[12px] text-[var(--color-white)]"
>
  ★{stars}
</span>
