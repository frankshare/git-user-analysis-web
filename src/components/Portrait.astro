---
import Avatar from './Avatar.astro';

interface Props {
  login: string;
  name: string;
  /** 头像直径 */
  size?: number;
  /** 弧环进度 0–1 */
  progress?: number;
  /** 环样式 */
  ring?: 'solid' | 'dashed' | 'double' | 'none';
  /** 主色（弧环 / 环线） */
  accent?: string;
  class?: string;
  eager?: boolean;
}
const {
  login,
  name,
  size = 104,
  progress = 0,
  ring = 'solid',
  accent = 'var(--color-seal)',
  class: cls = '',
  eager = false,
} = Astro.props;

const R = 57;
const C = 2 * Math.PI * R;
const pct = Math.max(0, Math.min(1, progress));
const dash = C * pct;
const track = 'rgba(23,20,15,0.11)';
const view = 120;
const pad = (view - size) / 2;
---

<div class:list={['relative shrink-0', cls]} style={`width:${size + 26}px;height:${size + 26}px`}>
  <!-- 弧环：星数占比 -->
  {
    ring !== 'none' && (
      <svg
        class="portrait-ring absolute inset-0 h-full w-full -rotate-90 transition-transform duration-[900ms] ease-out group-hover:rotate-45"
        viewBox={`0 0 ${view} ${view}`}
        aria-hidden="true"
      >
        <circle cx="60" cy="60" r={R} fill="none" stroke={track} stroke-width="2" />
        <circle
          cx="60"
          cy="60"
          r={R}
          fill="none"
          stroke={accent}
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-dasharray={`${dash} ${C - dash}`}
        />
      </svg>
    )
  }

  <!-- 装饰环 -->
  {
    (ring === 'solid' || ring === 'double') && (
      <span
        class="pointer-events-none absolute rounded-full border"
        style={`inset:7px;border-color:${accent}44`}
        aria-hidden="true"
      />
    )
  }
  {
    (ring === 'dashed' || ring === 'double') && (
      <span
        class="pointer-events-none absolute rounded-full border border-dashed"
        style={`inset:13px;border-color:${accent}2e`}
        aria-hidden="true"
      />
    )
  }
  {
    ring === 'dashed' && (
      <span
        class="pointer-events-none absolute rounded-full border"
        style={`inset:6px;border-color:${accent}30`}
        aria-hidden="true"
      />
    )
  }

  <!-- 头像本体 -->
  <span class="absolute" style={`inset:${pad}px`} transition:name={`portrait-${login}`}>
    <Avatar
      login={login}
      name={name}
      size={size}
      round
      eager={eager}
      plain
      class="h-full w-full shadow-[0_6px_18px_-8px_rgba(23,20,15,0.45)] transition-transform duration-[600ms] ease-out group-hover:scale-[1.05]"
    />
  </span>
</div>
