---
interface Props {
  login: string;
  name: string;
  size?: number;
  class?: string;
  eager?: boolean;
  /** 圆形头像（人物页用） */
  round?: boolean;
  /** 填满父容器（卡片大图用） */
  fill?: boolean;
}
const { login, name, size = 120, class: cls = '', eager = false, round = false, fill = false } = Astro.props;
const initial = (name || login || '?').trim().charAt(0).toUpperCase();
const seed = Array.from(login).reduce((a, c) => a + c.charCodeAt(0), 0);
const hue = seed % 4;
const tones = [
  ['#d9c9a7', '#4a4033'],
  ['#cdd3c0', '#3f4a37'],
  ['#d6c6c6', '#4d3a3a'],
  ['#c6cfd6', '#37414a'],
];
const [bg, fg] = tones[hue];
const shape = round ? 'rounded-full' : '';
---

<div
  class:list={['relative overflow-hidden shrink-0', shape, cls]}
  style={fill ? 'width:100%;height:100%' : `width:${size}px;height:${size}px`}
>
  <span
    class="fallback-avatar absolute inset-0 leading-none"
    style={`background:${bg};color:${fg};font-size:${Math.round(size * 0.42)}px`}
    aria-hidden="true">{initial}</span
  >
  <img
    src={`${import.meta.env.BASE_URL}avatars/${login}.jpg`}
    alt={name}
    width={size}
    height={size}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class="portrait absolute inset-0 h-full w-full object-cover"
    onload="this.previousElementSibling.style.display='none'"
    onerror="this.style.display='none'"
  />
</div>
